# KLASIFIKASI THRESHOLD PER BENCANA (BARU) — pengganti PrediksiSVM
# ═══════════════════════════════════════════════════════════════════
# Tidak lagi memuat model/scaler/encoder .pkl. Status & confidence dihitung
# murni dari tabel THRESHOLD_* di config di atas. Kalau fitur yang dipakai
# lebih dari satu (kebakaran: suhu+kelembapan; pencemaran: PM1.0+PM2.5+PM10),
# status akhir = level TERPARAH di antara fitur-fitur itu (worst-case).

class KlasifikasiThreshold:
    """
    Klasifikasi risiko berbasis THRESHOLD tetap (tanpa model SVM/scaler/encoder).

    - Status per fitur ditentukan dari tabel threshold-nya masing-masing.
    - Status akhir = level TERPARAH (worst-case) di antara semua fitur.
    - Confidence: semakin ke TENGAH rentang levelnya (untuk fitur yang
      menentukan status akhir), confidence semakin TINGGI; semakin dekat ke
      batas antar-level (ambigu dgn level tetangga), confidence semakin
      RENDAH. Kalau ada beberapa fitur yang sama-sama di level terparah,
      confidence-nya dirata-rata.
    - "prob" (prob_aman/waspada/siaga/bahaya) disusun agar konsisten dgn
      format payload lama: kelas terpilih = confidence, sisanya dibagi ke
      3 kelas lain, makin jauh levelnya dari status akhir makin kecil
      bagiannya.
    """

    SEVERITAS = ["Aman", "Waspada", "Siaga", "Bahaya"]

    def __init__(self, rentang_per_fitur, nama):
        self.rentang_per_fitur = rentang_per_fitur   # dict fitur -> tabel threshold
        self.fitur = list(rentang_per_fitur.keys())
        self.nama  = nama
        self.model = "threshold"   # bukan None -> kompatibel dgn pengecekan "model dimuat"

    def _klasifikasi_satu(self, nilai, rentang):
        """Klasifikasi satu nilai fitur. Return (status, confidence) atau None."""
        if nilai is None:
            return None

        idx = None
        for i, (status, lo, hi) in enumerate(rentang):
            if (lo is None or nilai >= lo) and (hi is None or nilai < hi):
                idx = i
                break
        if idx is None:
            return None
        status, lo, hi = rentang[idx]

        if lo is not None and hi is not None:
            tengah   = (lo + hi) / 2.0
            setengah = (hi - lo) / 2.0
            frac = 1.0 - abs(nilai - tengah) / setengah if setengah > 0 else 1.0
        elif lo is None:
            # kelas terbuka di bawah -> acuan skala = lebar kelas di atasnya
            tetangga    = rentang[idx + 1] if idx + 1 < len(rentang) else None
            lebar_acuan = (tetangga[2] - tetangga[1]) if (tetangga and tetangga[2] is not None) else max(hi, 1.0)
            frac = min((hi - nilai) / lebar_acuan, 1.0) if lebar_acuan else 1.0
        else:
            # kelas terbuka di atas -> acuan skala = lebar kelas di bawahnya
            tetangga    = rentang[idx - 1] if idx - 1 >= 0 else None
            lebar_acuan = (tetangga[2] - tetangga[1]) if tetangga else 1.0
            frac = min((nilai - lo) / lebar_acuan, 1.0) if lebar_acuan else 1.0

        frac = max(0.0, min(1.0, frac))
        confidence = BENCANA_CONF_MIN + frac * (BENCANA_CONF_MAX - BENCANA_CONF_MIN)
        return status, confidence

    def prediksi(self, data_sensor: dict, prob_defor: float = None):
        """Sengaja menerima `prob_defor` juga (diabaikan) supaya tetap kompatibel
        dipanggil dengan cara yang sama seperti PrediksiSVM.prediksi()."""
        try:
            hasil_fitur = []
            for f in self.fitur:
                r = self._klasifikasi_satu(data_sensor.get(f), self.rentang_per_fitur[f])
                if r is None:
                    return None
                hasil_fitur.append(r)

            idx_terparah = max(self.SEVERITAS.index(s) for s, _ in hasil_fitur)
            status       = self.SEVERITAS[idx_terparah]
            conf_terpilih = [c for s, c in hasil_fitur if s == status]
            confidence    = sum(conf_terpilih) / len(conf_terpilih)

            sisa  = 100.0 - confidence
            bobot = {s: 1.0 / (1 + abs(self.SEVERITAS.index(s) - idx_terparah))
                     for s in self.SEVERITAS if s != status}
            total_bobot = sum(bobot.values())
            prob = {s: round(sisa * w / total_bobot, 2) for s, w in bobot.items()}
            prob[status] = round(confidence, 2)

            return {"status": status, "confidence": round(confidence, 2), "prob": prob}
        except Exception as e:
            logging.error(f"Klasifikasi threshold ({self.nama}) error: {e}")
            return None


def buat_svm_kebakaran():
    return KlasifikasiThreshold(
        {"suhu": THRESHOLD_SUHU, "kelembapan": THRESHOLD_KELEMBAPAN},
        nama="kebakaran",
    )


def buat_svm_banjir():
    return KlasifikasiThreshold({"tinggi_air": THRESHOLD_TINGGI_AIR}, nama="banjir")


def buat_svm_pencemaran():
    return KlasifikasiThreshold(
        {"pm1_0": THRESHOLD_PM1_0, "pm2_5": THRESHOLD_PM2_5, "pm10": THRESHOLD_PM10},
        nama="pencemaran_udara",
    )


