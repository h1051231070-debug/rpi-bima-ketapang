def load_interpreter():
    """
    Load model CNN TFLite dari folder models/.
    Coba tflite_runtime dulu (lebih ringan), fallback ke TensorFlow penuh.
    """
    if not os.path.exists(MODEL_CNN):
        print(f"  {MERAH}[ERROR]{RESET} File '{MODEL_CNN}' tidak ditemukan!")
        print("  Pastikan model_cnn.tflite sudah disalin ke folder models/")
        sys.exit(1)

    try:
        import tflite_runtime.interpreter as tflite
        interp = tflite.Interpreter(model_path=MODEL_CNN)
        backend = "tflite_runtime"
    except ImportError:
        try:
            from ai_edge_litert.interpreter import Interpreter as LiteRTInterpreter
            interp = LiteRTInterpreter(model_path=MODEL_CNN)
            backend = "ai_edge_litert"
        except ImportError:
            try:
                import tensorflow as tf
                interp = tf.lite.Interpreter(model_path=MODEL_CNN)
                backend = "tensorflow"
            except ImportError:
                print(f"  {MERAH}[ERROR]{RESET} Tidak ada TFLite runtime!")
                print("  Install salah satu:")
                print("    pip install ai-edge-litert --break-system-packages   (untuk Python 3.12/3.13)")
                print("    pip install tflite-runtime --break-system-packages   (untuk Python <=3.11)")
                sys.exit(1)

    interp.allocate_tensors()
    inp = interp.get_input_details()
    out = interp.get_output_details()
    print(f"  {HIJAU}✓{RESET} Model CNN dimuat ({backend})")
    print(f"  {HIJAU}✓{RESET} Input  : {inp[0]['shape']}")
    print(f"  {HIJAU}✓{RESET} Output : {out[0]['shape']}")
    return interp, inp, out


