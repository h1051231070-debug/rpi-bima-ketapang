def format_payload_predikta(entri):
    """
    Format satu entri antrian menjadi dict JSON untuk predikta.site.
    STRUKTUR FIELD TIDAK DIUBAH dari versi SiPrediksi lama (field-by-field
    sama persis) supaya kompatibel dengan PHP yang sudah ada di server.
    """
    s    = entri.get("sensor", {})
    svm  = entri.get("svm", {})
    lstm = entri.get("lstm", {})
    pr   = entri.get("prediksi_risiko", {})
    cnn  = entri.get("cnn", {})
    prob = svm.get("prob", {})

    # Klasifikasi per bencana — masing-masing dari SVM sendiri
    bencana     = entri.get("bencana", {})
    kebakaran   = bencana.get("kebakaran", {})
    banjir      = bencana.get("banjir", {})
    pencemaran  = bencana.get("pencemaran", {})
    prob_keb    = kebakaran.get("prob", {})
    prob_banj   = banjir.get("prob", {})
    prob_penc   = pencemaran.get("prob", {})

    # Curah hujan (BARU) — threshold + confidence/prediksi acak. Entri antrian lama
    # (sebelum revisi ini) tidak punya key "hujan" -> semua field hujan jadi None.
    hujan       = entri.get("hujan", {}) or {}

    return {
        "api_key": API_KEY,
        "timestamp": entri.get("timestamp"),
        "lokasi": entri.get("lokasi", "ketapang"),
        "suhu": s.get("suhu"),
        "kelembapan": s.get("kelembapan"),
        "pm1_0": s.get("pm1_0"),
        "pm2_5": s.get("pm2_5"),
        "pm10": s.get("pm10"),
        "tinggi_air": s.get("tinggi_air"),
        "sumber": s.get("sumber", "sensor"),
        "status_risiko": svm.get("status"),
        "confidence_svm": svm.get("confidence"),
        "prob_aman": prob.get("Aman"),
        "prob_waspada": prob.get("Waspada"),
        "prob_siaga": prob.get("Siaga"),
        "prob_bahaya": prob.get("Bahaya"),
        "prediksi_nilai": lstm.get("prediksi_nilai"),
        "prediksi_status": lstm.get("prediksi_status"),
        "prediksi_risiko_status": pr.get("status"),
        "prediksi_risiko_confidence": pr.get("confidence"),
        "status_deforestasi": cnn.get("status_deforestasi"),
        "prob_deforestasi": cnn.get("prob_deforestasi"),
        # ── Klasifikasi per bencana ──
        "status_kebakaran": kebakaran.get("status"),
        "confidence_kebakaran": kebakaran.get("confidence"),
        "prob_kebakaran_aman": prob_keb.get("Aman"),
        "prob_kebakaran_waspada": prob_keb.get("Waspada"),
        "prob_kebakaran_siaga": prob_keb.get("Siaga"),
        "prob_kebakaran_bahaya": prob_keb.get("Bahaya"),
        "status_banjir": banjir.get("status"),
        "confidence_banjir": banjir.get("confidence"),
        "prob_banjir_aman": prob_banj.get("Aman"),
        "prob_banjir_waspada": prob_banj.get("Waspada"),
        "prob_banjir_siaga": prob_banj.get("Siaga"),
        "prob_banjir_bahaya": prob_banj.get("Bahaya"),
        "status_pencemaran": pencemaran.get("status"),
        "confidence_pencemaran": pencemaran.get("confidence"),
        "prob_pencemaran_aman": prob_penc.get("Aman"),
        "prob_pencemaran_waspada": prob_penc.get("Waspada"),
        "prob_pencemaran_siaga": prob_penc.get("Siaga"),
        "prob_pencemaran_bahaya": prob_penc.get("Bahaya"),
        # ── Curah hujan (BARU) — satuan mm/jam ──
        "curah_hujan": s.get("curah_hujan"),
        "status_hujan": hujan.get("status"),
        "confidence_hujan": hujan.get("confidence"),
        "prediksi_curah_hujan": hujan.get("prediksi_nilai"),
        "prediksi_status_hujan": hujan.get("prediksi_status"),
    }


