# PENGIRIMAN
# ═══════════════════════════════════════════════════════════════════

def _kirim_batch(url, payload_list, api_key):
    """
    Kirim list payload ke predikta.site via HTTP POST (array JSON, batch insert).

    PENTING: api_key WAJIB dikirim lewat HTTP header 'X-API-Key', karena
    fungsi cek_api_key() di server (config/auth.php) hanya mengecek header
    HTTP_X_API_KEY atau $_POST['api_key'] — TIDAK membaca field 'api_key'
    di dalam body JSON. Field 'api_key' tetap disertakan di tiap item
    payload (lihat format_payload_predikta) untuk kompatibilitas/dokumentasi,
    tapi itu TIDAK dipakai untuk autentikasi oleh server — autentikasi murni
    lewat header ini.

    Mengembalikan (sukses: bool, pesan: str).
    """
    if not REQUESTS_OK:
        return False, "requests tidak terinstall"
    if not payload_list:
        return True, "tidak ada data"

    try:
        r = requests.post(
            url,
            json    = {"data": payload_list},
            headers = {
                "Content-Type": "application/json",
                "X-API-Key"   : api_key,
            },
            timeout = HTTP_TIMEOUT,
        )
        if r.status_code == 200:
            resp = r.json()
            if resp.get("status") == "ok":
                return True, f"Terkirim {len(payload_list)} data"
            else:
                return False, f"Server error: {resp.get('pesan', 'unknown')}"
        else:
            detail = ""
            try:
                detail = f" — {r.json().get('pesan', '')}"
            except Exception:
                cuplikan = r.text[:150] if r.text else ""
                if cuplikan:
                    detail = f" — {cuplikan}"
            return False, f"HTTP {r.status_code}{detail}"
    except Exception as e:
        return False, str(e)


def _proses_target(antrian, url, api_key, format_fn, nama_log):
    """
    Kirim semua entri yang belum terkirim ke predikta.site.
    Menandai entri sukses secara in-place di `antrian` (list of dict).
    Return (jumlah_sukses, pesan).
    """
    belum_kirim = [e for e in antrian if not e.get("terkirim", False)]
    if not belum_kirim:
        return 0, "tidak ada data"

    payload_list = [format_fn(e) for e in belum_kirim]
    sukses, pesan = _kirim_batch(url, payload_list, api_key)

    if sukses:
        for e in belum_kirim:
            e["terkirim"] = True
        catat_kirim_log(nama_log, "sukses", pesan, len(belum_kirim))
        logging.info(f"[KIRIM {nama_log}] {pesan}")
        return len(belum_kirim), pesan
    else:
        catat_kirim_log(nama_log, "gagal", pesan, 0)
        logging.error(f"[KIRIM {nama_log} GAGAL] {pesan}")
        return 0, pesan


# ═══════════════════════════════════════════════════════════════════
# FUNGSI UTAMA — dipanggil dari main.py / simulasi.py
# ═══════════════════════════════════════════════════════════════════

def proses_pengiriman():
    """
    Fungsi utama pengiriman, dipanggil tiap INTERVAL_KIRIM:
      1. Muat antrian JSON
      2. Jika ada koneksi -> kirim ke predikta.site
      3. Entri yang sudah terkirim dibuang dari antrian
      4. Jika tidak ada koneksi -> log peringatan, coba lagi nanti
    """
    antrian = _muat_antrian()
    if not antrian:
        return

    if not cek_koneksi():
        logging.warning(f"Koneksi tidak tersedia. {len(antrian)} data pending di antrian.")
        return

    _proses_target(antrian, SERVER_URL, API_KEY, format_payload_predikta, "predikta")

    sisa = [e for e in antrian if not e.get("terkirim")]

    if len(sisa) != len(antrian):
        logging.info(f"{len(antrian) - len(sisa)} entri selesai terkirim, dibuang dari antrian")

    _simpan_antrian(sisa)


