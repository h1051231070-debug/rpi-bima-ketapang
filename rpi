def baca_sensor():
    """
    Fungsi utama pembacaan sensor.
    Secara otomatis memilih mode dummy atau sensor nyata
    berdasarkan MODE_DUMMY di config.py.

    Return:
        dict berisi semua nilai sensor (termasuk co_mq7) + timestamp + sumber
        atau None jika SEMUA sensor inti (FITUR_INPUT) gagal (hanya mode nyata).
        Kegagalan MQ-7 saja TIDAK menggagalkan siklus, karena CO bukan bagian
        dari FITUR_INPUT yang dipakai SVM/LSTM/CNN (lihat config.py).
    """
    if MODE_DUMMY:
        data = _dummy_sensor()
    else:
        data = _baca_sensor_nyata()
        # Validasi: cek apakah ada sensor INTI yang terbaca (co_mq7 di luar cek ini)
        fitur_gagal = [k for k in FITUR_INPUT if data.get(k) is None]
        if len(fitur_gagal) == len(FITUR_INPUT):
            return None  # semua sensor inti gagal

    data["timestamp"] = datetime.now().isoformat()
    return data


def cleanup_gpio():
    """Bersihkan GPIO saat program selesai."""
    global _gpio
    _cleanup_hujan()
    if _gpio is not None:
        try:
            _gpio.cleanup()
        except Exception:
            pass
        _gpio = None


