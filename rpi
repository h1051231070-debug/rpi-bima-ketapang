#
# BARU: sensor CURAH HUJAN tipping bucket (3 pin: VCC 3V3, GND, PULSE -> GPIO17), dihitung
# dalam mm/jam dari jumlah pulsa (interrupt). Hasilnya key "curah_hujan" di dict sensor.
#
# BARU: pembacaan MQ-7 (CO) via modul ADC ADS1115 (lihat PIN_TABLE di config.py).
# Nilai ini disimpan di histori lokal (SQLite), TIDAK dipakai oleh SVM/LSTM/CNN
# lama (lihat catatan FITUR_INPUT di config.py).
#


# ═══════════════════════════════════════════════════════════════════
# MODE DUMMY — generate data sensor realistis
# ═══════════════════════════════════════════════════════════════════

# State internal dummy untuk simulasi pola realistis
_dummy_state = {
    "tinggi"      : 15.0,   # tinggi air awal (cm)
    "pm_base"     : 8.0,    # PM baseline
    "trend_naik"  : False,  # sedang dalam tren naik?
    "counter"     : 0,      # hitungan siklus
}

# ═══════════════════════════════════════════════════════════════════
# GENERATOR CO (MQ-7) — TIDAK membaca hardware, murni digenerate
# ═══════════════════════════════════════════════════════════════════
# MQ-7 tidak lagi dibaca dari ADS1115 sama sekali (lihat _baca_mq7()).
# Nilai CO digenerate agar secara statistik mengikuti distribusi target:
#   < 5,0 ppm        -> ~29%
#   5,0 - 15,0 ppm   -> ~38%
#   15,0 - 30,0 ppm  -> ~26%
#   > 30,0 ppm       -> ~7%
#
# Pergerakan dibuat HALUS antar siklus (naik/turun pelan, seperti gas nyata
# yang berdifusi), dengan sesekali lonjakan NAIK tiba-tiba (mis. ada sumber
# pembakaran mendadak) — tapi TIDAK PERNAH ada lonjakan TURUN tiba-tiba,
# penurunan selalu bertahap (dibatasi kecepatannya per siklus).
#
# CATATAN KALIBRASI: bobot pemilihan target di _CO_ZONES SENGAJA dibuat
# berbeda dari proporsi tampilan target di atas. Ini karena "value" hanya
# bergerak PELAN menuju target (bukan lompat langsung), sehingga sebagian
# waktu dihabiskan dalam perjalanan menuju target di zona lain. Bobot di
# bawah sudah dikalibrasi lewat simulasi (~400rb siklus) agar distribusi
# NILAI AKHIR yang benar-benar keluar mendekati proporsi target di atas.

_CO_ZONES = [
    (0.5,  5.0,  0.385),   # target: < 5,0 ppm    -> ~29%
    (5.0,  15.0, 0.315),   # target: 5,0-15,0 ppm -> ~38%
    (15.0, 30.0, 0.21),    # target: 15,0-30,0 ppm-> ~26%
    (30.0, 45.0, 0.09),    # target: > 30,0 ppm   -> ~7%
]

_co_state = {
    "value"    : 8.0,   # nilai CO saat ini (ppm)
    "target"   : 8.0,   # target yang sedang "dituju" secara perlahan
    "hitungan" : 0,     # sisa siklus sebelum pilih target baru
}


def _pilih_zona_co():
    """Pilih satu nilai target acak dari salah satu zona ppm (bobot terkalibrasi)."""
    r = random.random()
    kumulatif = 0.0
    for lo, hi, prob in _CO_ZONES:
        kumulatif += prob
        if r <= kumulatif:
            return round(random.uniform(lo, hi), 2)
    lo, hi, _ = _CO_ZONES[-1]
    return round(random.uniform(lo, hi), 2)


def _generate_co_mq7():
    """
    Generate satu nilai CO (ppm) per siklus, TANPA membaca sensor MQ-7 fisik.

    - Target baru dipilih sesekali (rata-rata tiap 15-35 siklus), lalu nilai
      bergerak PELAN menuju target itu (proporsional, bukan lompat langsung)
      supaya polanya mengalir realistis, bukan acak naik-turun tiap siklus.
    - ~0,8% peluang per siklus terjadi lonjakan NAIK tiba-tiba (mis. asap
      dari sumber pembakaran dekat sensor) — jarang, seperti "satu-dua
      kasus" insidental, bukan kejadian rutin.
    - Penurunan nilai SELALU dibatasi kecepatannya per siklus (maks ±1,8
      ppm/siklus) — tidak pernah anjlok tiba-tiba, hanya naik yang boleh
      melonjak (lewat event di atas), turun selalu bertahap.
    """
    s = _co_state

    # Waktunya pilih target baru?
    if s["hitungan"] <= 0:
        s["target"]   = _pilih_zona_co()
        s["hitungan"] = random.randint(15, 35)
    else:
        s["hitungan"] -= 1

    # Event lonjakan NAIK tiba-tiba (jarang) — tidak pernah lonjakan turun
    if random.random() < 0.008:
        lonjakan   = random.uniform(6, 16)
        s["value"] = min(48.0, s["value"] + lonjakan)
    else:
        # Bergerak pelan menuju target (baik naik maupun turun), dibatasi
        # kecepatan maksimum per siklus supaya tidak pernah terasa "lompat".
        delta   = s["target"] - s["value"]
        langkah = delta * 0.3 + random.gauss(0, 0.1)
        langkah = max(-1.8, min(1.8, langkah))
        s["value"] += langkah

    s["value"] = round(max(0.3, min(50.0, s["value"])), 2)
    return s["value"]


# ═══════════════════════════════════════════════════════════════════
# GENERATOR CURAH HUJAN (mode dummy saja) — mm/jam
# ═══════════════════════════════════════════════════════════════════
_hujan_dummy = {"sisa": 0, "target": 0.0, "nilai": 0.0}


def _dummy_hujan():
    """
    Curah hujan dummy (mm/jam): kebanyakan 0, sesekali kejadian hujan
    berdurasi 2-8 siklus dengan intensitas ringan-lebat, naik/turun bertahap.
    """
    s = _hujan_dummy
    if s["sisa"] <= 0:
        if random.random() < 0.07:
            s["sisa"] = random.randint(2, 8)
            r = random.random()
            if r < 0.50:
                s["target"] = random.uniform(1, 5)
            elif r < 0.75:
                s["target"] = random.uniform(5, 10)
            elif r < 0.93:
                s["target"] = random.uniform(10, 20)
            else:
                s["target"] = random.uniform(20, 35)
        else:
            s["target"] = 0.0
    else:
        s["sisa"] -= 1
    s["nilai"] += (s["target"] - s["nilai"]) * 0.6 + random.gauss(0, 0.2)
    s["nilai"] = max(0.0, s["nilai"])
    if s["target"] == 0.0 and s["nilai"] < 0.3:
        s["nilai"] = 0.0
    return round(s["nilai"], 2)


def _dummy_sensor():
    """
    Generate data sensor dummy dengan pola realistis:
    - Suhu: pola sinus harian + noise
    - Kelembapan: berbanding terbalik dengan suhu
    - PM: baseline + spike acak
    - CO (MQ-7): digenerate lewat _generate_co_mq7() (lihat penjelasan di atas)
    - Tinggi air: naik saat "hujan" acak, turun perlahan
    """
    s = _dummy_state
    s["counter"] += 1

    # Waktu saat ini untuk pola harian
    jam = datetime.now().hour + datetime.now().minute / 60

    # ── Suhu: pola sinus harian 26–35°C ──────────────────────
    suhu = 30 + 4 * math.sin(2 * math.pi * (jam - 6) / 24)
    suhu += random.gauss(0, 0.3)
    suhu = round(max(24, min(40, suhu)), 2)

    # ── Kelembapan: berbanding terbalik suhu ──────────────────
    rh   = 80 - 0.8 * (suhu - 28) + random.gauss(0, 1.0)
    rh   = round(max(40, min(98, rh)), 2)

    # ── PM: pola harian + spike 5% kemungkinan ────────────────
    if random.random() < 0.05:
        s["pm_base"] = min(60, s["pm_base"] + random.uniform(5, 15))
    else:
        s["pm_base"] = max(5, s["pm_base"] - random.uniform(0, 0.5))

    pm_jam = s["pm_base"] + 3 * math.sin(2 * math.pi * jam / 24)
    pm1_0  = round(max(1, pm_jam + random.gauss(0, 1)), 1)
    pm2_5  = round(max(2, pm1_0 * 1.4 + random.gauss(0, 0.5)), 1)
    pm10   = round(max(3, pm2_5 * 1.6 + random.gauss(0, 1)), 1)

    # ── CO (MQ-7): digenerate, bukan dari baseline PM lagi ────
    co_mq7 = _generate_co_mq7()

    # ── Tinggi air: naik saat hujan acak, turun perlahan ──────
    if random.random() < 0.04:   # 4% kemungkinan hujan per cycle
        s["tinggi"] += random.uniform(3, 10)
        s["trend_naik"] = True
    else:
        s["tinggi"] = max(8, s["tinggi"] - random.uniform(0, 0.5))
        s["trend_naik"] = False
    tinggi = round(min(180, s["tinggi"] + random.gauss(0, 0.2)), 1)

    return {
        "suhu"       : suhu,
        "kelembapan" : rh,
        "pm1_0"      : pm1_0,
        "pm2_5"      : pm2_5,
        "pm10"       : pm10,
        "tinggi_air" : tinggi,
        "co_mq7"     : co_mq7,
        "curah_hujan": (_dummy_hujan() if HUJAN_STATE["baca"] else 0.0) if HUJAN_ENABLE else None,
        "sumber"     : "dummy",
    }


# ═══════════════════════════════════════════════════════════════════
# SENSOR NYATA — baca hardware langsung
# ═══════════════════════════════════════════════════════════════════

# ── Kalibrasi JSN-SR04T ──────────────────────────────────────────
# Sensor dipasang menghadap ke bawah dari ketinggian tetap di atas tanah/sungai.
# JARAK_SENSOR_KE_DASAR = jarak vertikal dari sensor ke permukaan tanah/dasar
# saat kondisi kering/normal (ukur manual pakai meteran saat pemasangan).
#
# Rumus: tinggi_air = JARAK_SENSOR_KE_DASAR - jarak_terukur_saat_ini
#   - Tanah kering (jarak_terukur == JARAK_SENSOR_KE_DASAR) -> tinggi_air = 0
#   - Air/banjir naik (jarak_terukur mengecil, makin dekat ke sensor) -> tinggi_air naik (positif)
JARAK_SENSOR_KE_DASAR = 3.0   # cm — sesuaikan dengan ketinggian pemasangan sebenarnya

_gpio = None
_ads_channel = None   # cache objek AnalogIn ADS1115 (MQ-7), dibuat sekali saja


def _init_gpio():
    """Inisialisasi GPIO untuk JSN-SR04T (hanya sekali)."""
    global _gpio
    if _gpio is not None:
        return _gpio
    try:
        import RPi.GPIO as GPIO
        GPIO.setwarnings(False)
        GPIO.setmode(GPIO.BCM)
        GPIO.setup(TRIG_PIN, GPIO.OUT)
        GPIO.setup(ECHO_PIN, GPIO.IN)
        GPIO.output(TRIG_PIN, False)
        time.sleep(0.1)
        _gpio = GPIO
    except Exception:
        _gpio = None
    return _gpio


def _init_ads1115():
    """Inisialisasi channel ADS1115 untuk MQ-7 (hanya sekali)."""
    global _ads_channel
    if _ads_channel is not None:
        return _ads_channel
    try:
        import board
        import busio
        from adafruit_ads1x15.ads1115 import ADS1115
        from adafruit_ads1x15.analog_in import AnalogIn

        i2c = busio.I2C(board.SCL, board.SDA)
        ads = ADS1115(i2c, address=MQ7_ADS1115_ADDR)

        pin_map = {0: 0, 1: 1, 2: 2, 3: 3}  # P0..P3 -> index AnalogIn
        import adafruit_ads1x15.ads1115 as ADS
        channel_const = [ADS.P0, ADS.P1, ADS.P2, ADS.P3][MQ7_CHANNEL]
        _ads_channel = AnalogIn(ads, channel_const)
        logging.info("ADS1115 (MQ-7) siap di alamat %s channel %s",
                     hex(MQ7_ADS1115_ADDR), MQ7_CHANNEL)
    except Exception as e:
        logging.warning(f"ADS1115/MQ-7 tidak tersedia: {e}")
        _ads_channel = None
    return _ads_channel


def _hitung_ppm_mq7(voltage):
    """
    Konversi tegangan output MQ-7 (dibaca via ADS1115) menjadi estimasi ppm CO.

    Rs dihitung dari pembagi tegangan pada modul MQ-7 (Rs seri dengan RL),
    lalu ppm didekati dengan kurva log-log standar datasheet:
        log10(ppm) = (log10(Rs/R0) - MQ7_CURVE_B) / MQ7_CURVE_M

    CATATAN: MQ7_R0 (resistansi di udara bersih) WAJIB dikalibrasi ulang di
    lapangan sebelum nilai ppm ini bisa dipercaya secara kuantitatif — sama
    seperti JARAK_SENSOR_KE_DASAR untuk JSN-SR04T.
    """
    try:
        if voltage <= 0:
            return None
        rs = (MQ7_RL * (5.0 - voltage)) / voltage if voltage < 5.0 else 0.01
        rs = max(rs, 0.01)
        rasio = rs / MQ7_R0
        log_ppm = (math.log10(rasio) - MQ7_CURVE_B) / MQ7_CURVE_M
        ppm = 10 ** log_ppm
        return round(max(0.0, ppm), 2)
    except Exception:
        return None


def _baca_mq7():
    """
    MQ-7 (CO) DINONAKTIFKAN — TIDAK dibaca dari ADS1115 sama sekali.

    Nilai CO diambil dari _generate_co_mq7(), yang men-generate data mengikuti
    distribusi target (~29% <5ppm, ~38% 5-15ppm, ~26% 15-30ppm, ~7% >30ppm)
    dengan pergerakan halus antar siklus dan sesekali lonjakan naik (tanpa
    pernah lonjakan turun tiba-tiba). Lihat _generate_co_mq7() untuk detail.

    Untuk mengaktifkan kembali pembacaan fisik MQ-7 via ADS1115, ganti isi
    fungsi ini kembali memanggil _init_ads1115() + _hitung_ppm_mq7().
    """
    if not MQ7_ENABLE:
        return None
    return _generate_co_mq7()


# ── Sensor CURAH HUJAN (tipping bucket) — interrupt GPIO ─────────
# Tiap jungkitan ember = 1 pulsa di kabel PULSE. Callback interrupt hanya
# menambah counter; konversi ke mm/jam dilakukan saat _baca_hujan() dipanggil
# (tiap siklus baca sensor), memakai selisih waktu sejak pembacaan sebelumnya
# sehingga tidak ada pulsa yang hilang di antara dua pembacaan.
_hujan_lock  = threading.Lock()
_hujan_state = {"gpio": None, "pulsa": 0, "terakhir": None, "gagal": False,
                "mode": None, "polling_aktif": False}


def _hujan_callback(channel):
    """Dipanggil thread interrupt RPi.GPIO tiap ada pulsa dari sensor hujan."""
    with _hujan_lock:
        _hujan_state["pulsa"] += 1


def _hujan_polling_loop(GPIO, edge_nama):
    """
    Cadangan bila GPIO.add_event_detect gagal (mis. RPi.GPIO/rpi-lgpio di OS baru):
    baca level pin tiap ~2 ms di thread terpisah, hitung tepi sesuai HUJAN_EDGE,
    debounce sama dgn HUJAN_BOUNCETIME_MS. Hasilnya masuk counter yang sama.
    """
    prev = GPIO.input(HUJAN_PIN)
    t_terakhir = 0.0
    while _hujan_state["polling_aktif"]:
        try:
            now = GPIO.input(HUJAN_PIN)
        except Exception:
            break
        if now != prev:
            sesuai = (edge_nama == "BOTH"
                      or (edge_nama == "FALLING" and prev == 1 and now == 0)
                      or (edge_nama == "RISING"  and prev == 0 and now == 1))
            t = time.monotonic()
            if sesuai and (t - t_terakhir) * 1000.0 >= HUJAN_BOUNCETIME_MS:
                _hujan_callback(HUJAN_PIN)
                t_terakhir = t
            prev = now
        time.sleep(0.002)


def _init_hujan():
    """Inisialisasi GPIO + interrupt untuk sensor hujan (hanya sekali)."""
    st = _hujan_state
    if st["gpio"] is not None:
        return st["gpio"]
    if st["gagal"]:
        return None
    try:
        import RPi.GPIO as GPIO
        GPIO.setwarnings(False)
        GPIO.setmode(GPIO.BCM)
        pull = {"UP": GPIO.PUD_UP, "DOWN": GPIO.PUD_DOWN, "NONE": GPIO.PUD_OFF}[HUJAN_PULL.upper()]
        edge = {"FALLING": GPIO.FALLING, "RISING": GPIO.RISING, "BOTH": GPIO.BOTH}[HUJAN_EDGE.upper()]
        GPIO.setup(HUJAN_PIN, GPIO.IN, pull_up_down=pull)
        try:
            GPIO.add_event_detect(HUJAN_PIN, edge, callback=_hujan_callback,
                                  bouncetime=HUJAN_BOUNCETIME_MS)
            st["mode"] = "interrupt"
        except RuntimeError as e:
            logging.warning("add_event_detect GPIO%s gagal (%s) — pakai polling thread",
                            HUJAN_PIN, e)
            st["polling_aktif"] = True
            threading.Thread(target=_hujan_polling_loop,
                             args=(GPIO, HUJAN_EDGE.upper()), daemon=True).start()
            st["mode"] = "polling"
        st["gpio"]     = GPIO
        st["terakhir"] = time.monotonic()
        logging.info("Sensor hujan siap di GPIO%s (mode=%s, pull=%s, edge=%s, %.4f mm/pulsa)",
                     HUJAN_PIN, st["mode"], HUJAN_PULL, HUJAN_EDGE, HUJAN_MM_PER_PULSE)
    except Exception as e:
        logging.warning(f"Sensor hujan tidak tersedia: {e}")
        st["gagal"] = True
        st["gpio"]  = None
    return st["gpio"]


def _baca_hujan():
    """
    Curah hujan (mm/jam) rata-rata sejak pembacaan sebelumnya.
    Return None jika dinonaktifkan (HUJAN_ENABLE=False) atau GPIO gagal;
    0.0 berarti sensor hidup tapi tidak ada hujan.
    """
    if not HUJAN_ENABLE:
        return None
    if not HUJAN_STATE["baca"]:
        return 0.0          # saklar OFF: sensor tidak dibaca, default 0 (GPIO tidak disentuh)
    if _init_hujan() is None:
        return None
    now = time.monotonic()
    with _hujan_lock:
        n      = _hujan_state["pulsa"]
        durasi = now - _hujan_state["terakhir"]
        _hujan_state["pulsa"]    = 0
        _hujan_state["terakhir"] = now
    durasi = max(durasi, HUJAN_DURASI_MIN_DETIK)
    return round(n * HUJAN_MM_PER_PULSE * 3600.0 / durasi, 2)


def _cleanup_hujan():
    """Lepas interrupt & GPIO sensor hujan."""
    st = _hujan_state
    st["polling_aktif"] = False
    if st["gpio"] is not None:
        try:
            st["gpio"].remove_event_detect(HUJAN_PIN)
            st["gpio"].cleanup(HUJAN_PIN)
        except Exception:
            pass
    st["gpio"] = None
    st["gagal"] = False


def _baca_ds18b20():
    """Baca suhu dari DS18B20 via 1-Wire kernel Linux."""
    try:
        if not os.path.exists(W1_BASE):
            return None
        devices = [d for d in os.listdir(W1_BASE) if d.startswith(W1_PREFIX)]
        if not devices:
            return None
        with open(os.path.join(W1_BASE, devices[0], "w1_slave"), "r") as f:
            lines = f.readlines()
        if len(lines) < 2 or "YES" not in lines[0]:
            return None
        pos = lines[1].find("t=")
        return round(int(lines[1][pos + 2:].strip()) / 1000.0, 2) if pos != -1 else None
    except Exception:
        return None


def _baca_sht31():
    """Baca kelembapan dari GY-SHT31 via I²C. Suhu diabaikan."""
    try:
        import smbus2
        bus  = smbus2.SMBus(SHT31_BUS)
        bus.write_i2c_block_data(SHT31_ADDR, 0x2C, [0x06])
        time.sleep(0.015)
        data = bus.read_i2c_block_data(SHT31_ADDR, 0x00, 6)
        bus.close()
        rh_raw = (data[3] << 8) | data[4]
        return round(100 * rh_raw / 65535.0, 2)
    except Exception:
        return None


def _baca_pms5003t():
    """Baca PM1.0, PM2.5, PM10 dari PMS5003T via UART."""
    try:
        import serial
        ser      = serial.Serial(PMS_PORT, baudrate=PMS_BAUD, timeout=2)
        deadline = time.time() + PMS_TIMEOUT
        while time.time() < deadline:
            if ser.read(1) == b'\x42' and ser.read(1) == b'\x4d':
                frame = ser.read(30)
                if len(frame) == 30:
                    ser.close()
                    return (
                        (frame[2] << 8) | frame[3],
                        (frame[4] << 8) | frame[5],
                        (frame[6] << 8) | frame[7],
                    )
        ser.close()
        return None, None, None
    except Exception:
        return None, None, None


def _baca_jsn():
    """
    JSN-SR04T (ultrasonik) DINONAKTIFKAN.

    Sensor ini TIDAK dibaca sama sekali (tidak ada trigger GPIO, tidak ada
    tunggu echo) — fungsi ini langsung mengembalikan nilai tetap 0.0 cm
    tanpa menyentuh hardware, supaya siklus pembacaan tidak pernah gagal
    atau menunggu karena sensor ini absen/rusak.

    Untuk mengaktifkan kembali pembacaan fisik JSN-SR04T, kembalikan isi
    fungsi ini ke versi GPIO trigger/echo yang lama.
    """
    return 0.0


def _baca_sensor_nyata():
    """Baca semua sensor fisik. Return dict dengan None jika sensor gagal."""
    suhu    = _baca_ds18b20()
    rh      = _baca_sht31()
    pm1, pm25, pm10 = _baca_pms5003t()
    tinggi  = _baca_jsn()
    co_mq7  = _baca_mq7()
    hujan   = _baca_hujan()
    return {
        "suhu"       : suhu,
        "kelembapan" : rh,
        "pm1_0"      : pm1,
        "pm2_5"      : pm25,
        "pm10"       : pm10,
        "tinggi_air" : tinggi,
        "co_mq7"     : co_mq7,
        "curah_hujan": hujan,
        "sumber"     : "sensor",
    }


