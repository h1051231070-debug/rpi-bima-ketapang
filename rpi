def _tampilkan_banner():
    print(f"\n{BOLD}{MERAH2}{'='*54}{RESET}")
    print(f"{BOLD}{MERAH2}              MODE A2 AKTIF{RESET}")
    print(f"{BOLD}{MERAH2}        DATA HANYA UNTUK TESTING/DEMO WEB{RESET}")
    print(f"{BOLD}{MERAH2}{'='*54}{RESET}\n")


def _tampilkan_siklus_simulasi(no, data, hasil_svm, batch_baru_dibuat,
                                hasil_kebakaran=None, hasil_banjir=None, hasil_pencemaran=None,
                                hasil_hujan=None):
    waktu = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    kelas = hasil_svm.get("status", "?") if hasil_svm else "?"
    warna = WARNA_RISIKO.get(kelas, RESET)
    conf  = hasil_svm.get("confidence", 0) if hasil_svm else 0

    print(f"\n  {'-'*58}")
    print(f"  {CYAN}[A2] #{no:<4}{RESET}  {waktu}")
    print(f"  {'-'*58}")
    print(f"    suhu={data.get('suhu')}  RH={data.get('kelembapan')}  "
          f"PM1.0={data.get('pm1_0')}  PM2.5={data.get('pm2_5')}  PM10={data.get('pm10')}  "
          f"tinggi_air={data.get('tinggi_air')}")
    print(f"    Utama : {warna}{BOLD}{kelas}{RESET}  confidence {conf:.1f}%  "
          f"{ABU}(sumber data: A2){RESET}")
    if batch_baru_dibuat:
        print(f"    {KUNING}[A2] {SIMULASI_HORIZON} horizon prediksi baru dibuat "
              f"(generator sintetis, BUKAN LSTM){RESET}")

    for label, hasil in [("Kebakaran", hasil_kebakaran),
                          ("Banjir", hasil_banjir),
                          ("Pencemaran Udara", hasil_pencemaran)]:
        if hasil:
            k = hasil.get("status", "?")
            w = WARNA_RISIKO.get(k, RESET)
            c = hasil.get("confidence", 0)
            print(f"    {label:<18}: {w}{BOLD}{k}{RESET}  confidence {c:.1f}%")

    ch = data.get("curah_hujan")
    if ch is not None and hasil_hujan:
        k  = hasil_hujan.get("status", "?")
        pk = hasil_hujan.get("prediksi_status", "?")
        print(f"    {'Curah Hujan':<18}: {WARNA_RISIKO.get(k, RESET)}{BOLD}{k}{RESET}  {ch} mm/jam ({'data A1' if HUJAN_STATE['baca'] else 'sensor OFF, default 0'})  "
              f"confidence {hasil_hujan.get('confidence', 0):.1f}%")
        print(f"    {'  prediksi hujan':<18}: {hasil_hujan.get('prediksi_nilai')} mm/jam  "
              f"{WARNA_RISIKO.get(pk, RESET)}{pk}{RESET}")
    else:
        print(f"    {'Curah Hujan':<18}: {KUNING}tidak tersedia{RESET}")

    _tampilkan_panel_sensor(data)   # BARU: status sensor + data aktual di sebelah data simulasi


