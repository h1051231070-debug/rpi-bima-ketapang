def preprocessing(path_gambar):
    """Load gambar → RGB → resize 224×224 → normalisasi → batch."""
    if not os.path.exists(path_gambar):
        print(f"  {MERAH}[ERROR]{RESET} Gambar '{path_gambar}' tidak ditemukan!")
        sys.exit(1)

    ekstensi = os.path.splitext(path_gambar)[1].lower()
    if ekstensi not in (".png", ".jpg", ".jpeg", ".bmp", ".tiff"):
        print(f"  {MERAH}[ERROR]{RESET} Format '{ekstensi}' tidak didukung.")
        sys.exit(1)

    img     = Image.open(path_gambar).convert("RGB")
    ukuran  = img.size
    resized = img.resize(IMG_SIZE, Image.LANCZOS)
    arr     = np.array(resized, dtype=np.float32) / 255.0
    batch   = np.expand_dims(arr, axis=0)
    return batch, ukuran


def inferensi(interp, inp_details, out_details, img_batch):
    """Jalankan inferensi TFLite, kembalikan (prob_forest, prob_defor)."""
    interp.set_tensor(inp_details[0]["index"], img_batch)
    interp.invoke()
    output     = interp.get_tensor(out_details[0]["index"])[0][0]
    prob_forest = float(output)
    prob_defor  = 1.0 - prob_forest
    return prob_forest, prob_defor


def tentukan_status(prob_defor):
    """Tentukan status deforestasi berdasarkan threshold."""
    if prob_defor > THRESHOLD_TINGGI:
        return "Tinggi"
    elif prob_defor >= THRESHOLD_SEDANG:
        return "Sedang"
    else:
        return "Rendah"


