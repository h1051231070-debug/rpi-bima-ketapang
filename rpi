THRESHOLD_SEDANG = 0.40


WARNA_STATUS = {"Rendah": HIJAU, "Sedang": KUNING, "Tinggi": MERAH2}
EMOJI_STATUS = {"Rendah": "🌿", "Sedang": "⚠️ ", "Tinggi": "🚨"}


