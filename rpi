def _muat_antrian():
    """Muat antrian JSON. Kembalikan list kosong jika belum ada / rusak."""
    if not os.path.exists(ANTRIAN_PATH):
        return []
    try:
        with open(ANTRIAN_PATH, "r") as f:
            isi = json.load(f)
        return isi if isinstance(isi, list) else []
    except Exception as e:
        logging.error(f"Gagal baca antrian JSON, mulai dari kosong: {e}")
        return []


def _simpan_antrian(antrian: list):
    """Tulis ulang seluruh antrian JSON (atomic-ish via file sementara)."""
    tmp_path = ANTRIAN_PATH + ".tmp"
    try:
        with open(tmp_path, "w") as f:
            json.dump(antrian, f, indent=2)
        os.replace(tmp_path, ANTRIAN_PATH)
    except Exception as e:
        logging.error(f"Gagal simpan antrian JSON: {e}")


def tambah_antrian(data_sensor, hasil_svm, hasil_lstm, data_defor,
                    hasil_prediksi_risiko=None, row_id=None,
                    hasil_kebakaran=None, hasil_banjir=None, hasil_pencemaran=None,
                    hasil_hujan=None):
    """
    Tambahkan satu entri baru ke antrian JSON (dipanggil tiap siklus dari main.py,
    setelah simpan_data). Entri ini yang nanti dibaca kirim_data.py untuk dikirim
    ke predikta.site (SATU server, independen).
    """
    entri = {
        "row_id"    : row_id,
        "timestamp" : data_sensor.get("timestamp"),
        "lokasi"    : LOKASI,   # dikirim ke predikta.site agar web bisa filter per lokasi
        "sensor"    : {
            "suhu"       : data_sensor.get("suhu"),
            "kelembapan" : data_sensor.get("kelembapan"),
            "pm1_0"      : data_sensor.get("pm1_0"),
            "pm2_5"      : data_sensor.get("pm2_5"),
            "pm10"       : data_sensor.get("pm10"),
            "tinggi_air" : data_sensor.get("tinggi_air"),
            "co_mq7"     : data_sensor.get("co_mq7"),
            "curah_hujan": data_sensor.get("curah_hujan"),   # mm/jam (BARU)
            "sumber"     : data_sensor.get("sumber", "sensor"),
        },
        "svm"      : hasil_svm or {},
        "lstm"     : hasil_lstm or {},
        "prediksi_risiko": hasil_prediksi_risiko or {},
        "cnn"      : {
            "status_deforestasi": data_defor.get("status_deforestasi"),
            "prob_deforestasi"  : data_defor.get("prob_deforestasi"),
        },
        # ── Klasifikasi PER BENCANA (BARU) — masing-masing dari SVM sendiri ──
        "bencana"  : {
            "kebakaran"   : hasil_kebakaran  or {},
            "banjir"      : hasil_banjir     or {},
            "pencemaran"  : hasil_pencemaran or {},
        },
        # ── Curah hujan (BARU): threshold + confidence/prediksi acak ──
        "hujan"    : hasil_hujan or {},
        "terkirim" : False,
    }

    antrian = _muat_antrian()
    antrian.append(entri)

    # Batasi ukuran antrian — buang entri tertua jika melebihi MAX_ANTRIAN
    if len(antrian) > MAX_ANTRIAN:
        kelebihan = len(antrian) - MAX_ANTRIAN
        logging.warning(f"Antrian JSON melebihi MAX_ANTRIAN, buang {kelebihan} entri tertua")
        antrian = antrian[kelebihan:]

    _simpan_antrian(antrian)


