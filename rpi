def jalankan_mode_simulasi(demo=False):
    """
    Loop utama mode --simulasi. Mirip alur main.py, tapi:
      - "Data aktual" yang disimpan/dikirim adalah "data simulasi" (forecast
        yang ditarik ke arah pembacaan sensor real/dummy siklus ini) —
        bukan pembacaan sensor langsung TANPA penyesuaian.
      - TIDAK memakai PrediksiLSTM / model_lstm.tflite sama sekali; forecast
        dihasilkan generator sintetis (generate_prediksi_simulasi).
      - PrediksiSVM asli tetap dipakai untuk klasifikasi risiko.
      - Tetap memakai database.py & kirim_data.py apa adanya, supaya
        website menerima data dengan format yang sama seperti mode normal.
      - HANYA independen untuk predikta.site (satu server, satu jalur).
    """
    _tampilkan_banner()
    logging.info("[A2] Mode A2 diaktifkan (python main.py --simulasi)")

    init_db()
    print(f"  {HIJAU}✓{RESET} Database SQLite siap (mode A2)")

    print(f"  Menyiapkan klasifikasi utama (skor tertimbang)...", end=" ", flush=True)
    svm = KlasifikasiUtama()   # klasifikasi utama (status risiko gabungan) — pengganti SVM umum
    svm_kebakaran  = buat_svm_kebakaran()
    svm_banjir     = buat_svm_banjir()
    svm_pencemaran = buat_svm_pencemaran()
    print(f"{HIJAU}OK{RESET}")
    print(f"  {ABU}(PrediksiLSTM TIDAK dimuat pada mode A2 — sesuai desain){RESET}")

    data_defor = ambil_deforestasi_fixed()
    prob_defor = data_defor.get("prob_deforestasi")
    if prob_defor is None:
        prob_defor = 0.317
    print(f"  {HIJAU}✓{RESET} prob_deforestasi (fixed, dari deforestasi.json) = {prob_defor}")
    print(f"  {HIJAU}✓{RESET} Mode A2 independen predikta.site — baca sensor dulu, baru disimulasikan")

    if demo:
        print(f"  {KUNING}Mode demo — satu siklus saja{RESET}")

    print(f"\n  Memulai loop A2... (Ctrl+C untuk berhenti)\n")

    state       = _StateSimulasi(prob_defor)
    no          = 0
    waktu_kirim = time.time()

    try:
        while True:
            no += 1

            data_sensor, hasil_prediksi_untuk_disimpan, batch_baru_dibuat = \
                generate_baris_simulasi(state, svm)

            if data_sensor is None:
                print(f"  {KUNING}[A2 #{no}] Semua sensor inti gagal — lewati{RESET}")
                time.sleep(INTERVAL_BACA)
                continue

            # Klasifikasi risiko SAAT INI (baris ini) via SVM asli
            hasil_svm = svm.prediksi(data_sensor, prob_defor)

            # Klasifikasi PER BENCANA — SVM asli per jenis bencana, dari
            # data_sensor yang sama (tinggi_air selalu 0, lihat docstring modul).
            hasil_kebakaran  = svm_kebakaran.prediksi(data_sensor)
            hasil_banjir     = svm_banjir.prediksi(data_sensor)
            hasil_pencemaran = svm_pencemaran.prediksi(data_sensor)

            # Curah hujan — DATA REAL sensor (tidak disimulasikan); klasifikasi threshold,
            # confidence & prediksi acak.
            hasil_hujan = analisis_hujan(data_sensor.get("curah_hujan"))

            # Pipeline "prediksi -> SVM" untuk T+1, memakai horizon pertama
            # dari forecast simulasi yang BARU SAJA dihitung fresh siklus ini.
            hasil_prediksi_risiko = None
            if hasil_prediksi_untuk_disimpan:
                try:
                    pred_t1 = {f: hasil_prediksi_untuk_disimpan["prediksi_nilai"][f][0] for f in _FITUR_WALK}
                    pred_t1["tinggi_air"] = 0
                    hasil_prediksi_risiko = svm.prediksi(pred_t1, prob_defor)
                except Exception as e:
                    logging.error(f"[A2] Gagal buat prediksi_risiko: {e}")

            # Simpan ke SQLite (histori lokal) — memakai database.py apa adanya.
            row_id = simpan_data(data_sensor, hasil_svm or {}, hasil_prediksi_untuk_disimpan,
                                  data_defor, hasil_prediksi_risiko,
                                  hasil_kebakaran, hasil_banjir, hasil_pencemaran,
                                  hasil_hujan=hasil_hujan)

            # Tambahkan ke antrian JSON — independen untuk predikta.site saja.
            tambah_antrian(data_sensor, hasil_svm or {}, hasil_prediksi_untuk_disimpan,
                            data_defor, hasil_prediksi_risiko, row_id=row_id,
                            hasil_kebakaran=hasil_kebakaran, hasil_banjir=hasil_banjir,
                            hasil_pencemaran=hasil_pencemaran, hasil_hujan=hasil_hujan)

            _tampilkan_siklus_simulasi(no, data_sensor, hasil_svm, batch_baru_dibuat,
                                        hasil_kebakaran, hasil_banjir, hasil_pencemaran, hasil_hujan)

            # Kirim ke server sesuai interval — memakai kirim_data.py apa adanya
            if time.time() - waktu_kirim >= INTERVAL_KIRIM:
                print(f"  {ABU}[A2] Mengirim data ke server...{RESET}", end=" ", flush=True)
                logging.info("[A2] Mengirim data ke server")
                proses_pengiriman()
                print(f"{HIJAU}selesai{RESET}")
                waktu_kirim = time.time()

            if demo:
                print(f"\n  {HIJAU}[A2] Demo selesai.{RESET}\n")
                break

            time.sleep(INTERVAL_BACA)

    except KeyboardInterrupt:
        print(f"\n\n  {KUNING}[A2] Dihentikan.{RESET}")
        logging.info("[A2] Dihentikan oleh pengguna.")
    finally:
        print(f"  Total data tersimpan (termasuk data A2): {hitung_total()}\n")


