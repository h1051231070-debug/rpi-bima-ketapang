class DataCNN:
    """
    Baca hasil CNN dari deforestasi.json.
    File ini dibuat sekali saat setup dengan predict_cnn.py.
    Jika file tidak ada, kembalikan nilai default.
    """

    def __init__(self):
        self.data = self._load()

    def _load(self):
        if not os.path.exists(DEFOR_PATH):
            logging.warning(f"deforestasi.json tidak ditemukan di {DEFOR_PATH}")
            return {
                "status_deforestasi" : "Tidak Diketahui",
                "prob_deforestasi"   : 0.0,
                "prob_forest"        : 0.0,
                "kelas"              : "Tidak Diketahui",
                "file_gambar"        : "-",
                "waktu_proses"       : "-",
            }
        try:
            with open(DEFOR_PATH, "r") as f:
                data = json.load(f)
            logging.info(f"CNN data dimuat: {data.get('status_deforestasi')}")
            return data
        except Exception as e:
            logging.error(f"Gagal baca deforestasi.json: {e}")
            return {"status_deforestasi": "Error", "prob_deforestasi": 0.0}

    def get(self):
        """Kembalikan dict data CNN."""
        return self.data


