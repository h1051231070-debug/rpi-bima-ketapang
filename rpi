def ambil_buffer_lstm(n=10):
    """
    Ambil N pembacaan terakhir dari SQLite untuk input LSTM.
    Mengembalikan list of dict, atau None jika data kurang dari N.
    """
    conn = sqlite3.connect(DB_PATH)
    c    = conn.cursor()
    c.execute("""
        SELECT suhu, kelembapan, pm1_0, pm2_5, pm10, tinggi_air
        FROM sensor_log
        ORDER BY id DESC
        LIMIT ?
    """, (n,))
    rows = c.fetchall()
    conn.close()

    if len(rows) < n:
        return None

    # Balik urutan (terlama dulu)
    rows = list(reversed(rows))
    kolom = ["suhu", "kelembapan", "pm1_0", "pm2_5", "pm10", "tinggi_air"]
    return [dict(zip(kolom, row)) for row in rows]


def catat_kirim_log(target, status, pesan, n_data=0):
    """Catat hasil pengiriman ke tabel kirim_log. target: 'predikta'."""
    conn = sqlite3.connect(DB_PATH)
    c    = conn.cursor()
    c.execute("""
        INSERT INTO kirim_log (timestamp, target, status, pesan, n_data)
        VALUES (?,?,?,?,?)
    """, (datetime.now().isoformat(), target, status, pesan, n_data))
    conn.commit()
    conn.close()


