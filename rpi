# ═══════════════════════════════════════════════════════════════════
# PREDIKSI SVM
# ═══════════════════════════════════════════════════════════════════

class PrediksiSVM:
    """
    Load model SVM dari .pkl dan lakukan inferensi real-time.
    Mengembalikan status risiko + probabilitas per kelas.

    BARU — kelas ini sekarang GENERIK: bisa dipakai untuk SVM "umum"
    (status risiko gabungan, default/tanpa argumen — perilaku identik
    dengan versi lama) MAUPUN untuk SVM klasifikasi per bencana
    (kebakaran/banjir/pencemaran udara), tinggal beri path model/scaler/
    encoder dan daftar fitur sendiri. Lihat factory function
    buat_svm_kebakaran()/buat_svm_banjir()/buat_svm_pencemaran() di bawah.
    """

    def __init__(self, model_path=MODEL_SVM, scaler_path=SCALER_SVM,
                 encoder_path=ENCODER_SVM, fitur=None, nama="umum"):
        self.model_path   = model_path
        self.scaler_path  = scaler_path
        self.encoder_path = encoder_path
        # Default fitur = FITUR_SVM (6 fitur sensor + prob_deforestasi),
        # SAMA seperti perilaku lama supaya PrediksiSVM() tanpa argumen
        # (dipakai main.py/simulasi.py untuk SVM umum) tidak berubah.
        self.fitur  = fitur if fitur is not None else FITUR_SVM
        self.nama   = nama
        self.model   = None
        self.scaler  = None
        self.encoder = None
        self._load()

    def _load(self):
        try:
            import joblib
            self.model   = joblib.load(self.model_path)
            self.scaler  = joblib.load(self.scaler_path)
            self.encoder = joblib.load(self.encoder_path)
            logging.info(f"SVM ({self.nama}) model dimuat")
        except Exception as e:
            logging.error(f"Gagal load SVM ({self.nama}): {e}")

    def prediksi(self, data_sensor: dict, prob_defor: float = None):
        """
        Prediksi kelas risiko dari dict data sensor.

        Parameter:
            data_sensor : dict berisi minimal fitur-fitur di self.fitur
            prob_defor  : probabilitas deforestasi dari CNN. HANYA dipakai
                          kalau "prob_deforestasi" ada di self.fitur (yaitu
                          untuk SVM umum) — model per-bencana yang baru
                          (kebakaran/banjir/pencemaran udara) TIDAK memakai
                          fitur ini sama sekali, jadi parameter ini diabaikan.
                          Jika None (dan dibutuhkan), dianggap 0.0.

        Return dict {status, confidence, prob} atau None jika gagal.
        """
        if self.model is None:
            return None
        try:
            input_data = dict(data_sensor)
            if "prob_deforestasi" in self.fitur:
                input_data["prob_deforestasi"] = prob_defor if prob_defor is not None else 0.0

            vektor        = [[input_data[f] for f in self.fitur]]
            vektor_scaled = self.scaler.transform(vektor)
            label_idx     = self.model.predict(vektor_scaled)[0]
            kelas         = self.encoder.inverse_transform([label_idx])[0]

            prob_arr   = self.model.predict_proba(vektor_scaled)[0]
            prob_dict  = {
                self.encoder.inverse_transform([i])[0]: round(float(p) * 100, 2)
                for i, p in enumerate(prob_arr)
            }
            return {
                "status"    : kelas,
                "confidence": round(prob_dict[kelas], 2),
                "prob"      : prob_dict,
            }
        except Exception as e:
            logging.error(f"SVM ({self.nama}) prediksi error: {e}")
            return None


