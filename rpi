# CURAH HUJAN — threshold biasa (BUKAN model) + confidence/prediksi acak
# ═══════════════════════════════════════════════════════════════════

def klasifikasi_hujan(curah_hujan):
    """
    Klasifikasi curah hujan (mm/jam) dengan THRESHOLD biasa, tanpa model:
        0  <= x <  5   -> Aman
        5  <= x <  10  -> Waspada
        10 <= x <= 20  -> Siaga
        x  >  20       -> Bahaya
    Return string status, atau None jika curah_hujan None.
    """
    if curah_hujan is None:
        return None
    if curah_hujan < HUJAN_BATAS_WASPADA:
        return "Aman"
    if curah_hujan < HUJAN_BATAS_SIAGA:
        return "Waspada"
    if curah_hujan <= HUJAN_BATAS_BAHAYA:
        return "Siaga"
    return "Bahaya"


def prediksi_curah_hujan_acak(curah_hujan):
    """
    Prediksi curah hujan SINTETIS (bukan LSTM): nilai sensor + acak dalam
    +-HUJAN_PRED_DELTA_MAX mm/jam. Tidak pernah negatif — kalau hasil < 0,
    nilainya dipantulkan (abs) sehingga selisih ke sensor tetap <= batas.
    """
    if curah_hujan is None:
        return None
    if not HUJAN_STATE["baca"]:
        return 0.0          # saklar baca sensor hujan OFF -> prediksi selalu 0
    nilai = curah_hujan + random.uniform(-HUJAN_PRED_DELTA_MAX, HUJAN_PRED_DELTA_MAX)
    return round(abs(nilai), 2)


def analisis_hujan(curah_hujan):
    """
    Satu paket hasil untuk curah hujan (dipanggil main.py & simulasi.py tiap siklus):
        {
          "status"         : status dari threshold (nilai sensor),
          "confidence"     : ACAK HUJAN_CONF_MIN..HUJAN_CONF_MAX (persen),
          "prediksi_nilai" : prediksi acak (mm/jam),
          "prediksi_status": status dari threshold yang sama utk nilai prediksi,
        }
    Return None jika curah_hujan None (sensor hujan gagal / dinonaktifkan).
    """
    if curah_hujan is None:
        return None
    pred = prediksi_curah_hujan_acak(curah_hujan)
    return {
        "status"         : klasifikasi_hujan(curah_hujan),
        "confidence"     : round(random.uniform(HUJAN_CONF_MIN, HUJAN_CONF_MAX), 2),
        "prediksi_nilai" : pred,
        "prediksi_status": klasifikasi_hujan(pred),
    }


