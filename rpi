_FITUR_WALK = ["suhu", "kelembapan", "pm1_0", "pm2_5", "pm10"]

# Titik tengah mean-reversion untuk forecast (generate_prediksi_simulasi) —
# TIDAK LAGI dipakai sebagai titik awal random-walk "data sensor" (sekarang
# "data sensor" selalu datang dari baca_sensor() real/dummy), hanya dipakai
# supaya tren forecast sintetis tidak melenceng liar tanpa batas antar-siklus.
_NILAI_AWAL = {
    "suhu"       : 33.12,
    "kelembapan" : 58.90,
    "pm1_0"      : 40,
    "pm2_5"      : 70,
    "pm10"       : 110,
}

# Batas nilai realistis per fitur — dipakai untuk clamp forecast & hasil
# akhir "data simulasi" (bukan untuk membatasi pembacaan sensor asli).
# PM: batas bawah 0 (konsentrasi tidak bisa negatif), batas atas 150 masing-masing.
_BATAS_NILAI = {
    "suhu"       : (20.0, 40.0),
    "kelembapan" : (35.0, 85.0),
    "pm1_0"      : (0, 150),
    "pm2_5"      : (0, 150),
    "pm10"       : (0, 150),
}

# Skala deviasi maksimum forecast (sbg fraksi lebar rentang fitur) — dipakai
# HANYA oleh generate_prediksi_simulasi() untuk membatasi tren antar-horizon,
# TIDAK dipakai lagi oleh generate_data_simulasi() (lihat fungsi itu: deviasi
# akurasi sekarang dihitung relatif terhadap nilai prediksi, bukan lebar
# rentang fitur).
_BATAS_TREN = {"suhu": 0.5, "kelembapan": 1.0, "pm1_0": 8, "pm2_5": 10, "pm10": 10}


def _clamp(fitur, nilai, batas_dict=None):
    """
    Batasi nilai ke rentang realistis fitur tsb.

    Overshoot (nilai > hi atau < lo) "dipantulkan" balik ke dalam rentang
    (reflect) supaya variasinya tetap wajar; hard clamp cuma dipakai sbg
    fallback kalau pantulannya masih di luar rentang (overshoot ekstrem).
    """
    batas_dict = batas_dict or _BATAS_NILAI
    batas = batas_dict.get(fitur)
    if batas is None:
        return nilai
    lo, hi = batas
    if nilai > hi:
        nilai = hi - (nilai - hi)
    elif nilai < lo:
        nilai = lo + (lo - nilai)
    return max(lo, min(hi, nilai))


def _bulatkan(fitur, nilai):
    """PM dibulatkan ke bilangan bulat (mengikuti pola contoh), fitur lain 2 desimal."""
    if fitur in ("pm1_0", "pm2_5", "pm10"):
        return round(nilai)
    return round(nilai, 2)


PM_MAKS = 150


def _paksa_urutan_pm(d):
    """
    Pastikan pm1_0 < pm2_5 < pm10 dan semuanya <= PM_MAKS (150).
    Bekerja in-place pada dict, hasilnya bilangan bulat.
    Selisih minimal antar-PM = 1 µg/m³ (syarat '<' murni).
    """
    if not all(k in d and d[k] is not None for k in ("pm1_0", "pm2_5", "pm10")):
        return d
    pm1  = int(max(0, min(PM_MAKS - 2, round(d["pm1_0"]))))
    pm25 = int(max(pm1 + 1, min(PM_MAKS - 1, round(d["pm2_5"]))))
    pm10 = int(max(pm25 + 1, min(PM_MAKS, round(d["pm10"]))))
    d["pm1_0"], d["pm2_5"], d["pm10"] = pm1, pm25, pm10
    return d


