def init_db():
    """
    Buat tabel jika belum ada, dan migrasi kolom baru (co_mq7) jika perlu.
    Dipanggil sekali saat startup main.py.
    """
    conn = sqlite3.connect(DB_PATH)
    c    = conn.cursor()

    # Tabel utama: data sensor + hasil prediksi
    c.execute("""
        CREATE TABLE IF NOT EXISTS sensor_log (
            id              INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp       TEXT NOT NULL,

            -- Lokasi perangkat (BARU) — "ketapang" / "pontianak", lihat config.LOKASI
            lokasi          TEXT DEFAULT 'ketapang',

            -- Data sensor
            suhu            REAL,
            kelembapan      REAL,
            pm1_0           REAL,
            pm2_5           REAL,
            pm10            REAL,
            tinggi_air      REAL,
            co_mq7          REAL,
            curah_hujan     REAL,   -- mm/jam (sensor hujan, BARU)
            sumber          TEXT DEFAULT 'sensor',

            -- Hasil SVM umum (status risiko gabungan, TIDAK berubah)
            status_risiko   TEXT,
            confidence_svm  REAL,
            prob_aman       REAL,
            prob_waspada    REAL,
            prob_siaga      REAL,
            prob_bahaya     REAL,

            -- Hasil LSTM (JSON string)
            prediksi_nilai  TEXT,   -- JSON: {suhu:[...], kelembapan:[...], ...}
            prediksi_status TEXT,   -- JSON: ["Aman", "Waspada", ...]

            -- LSTM -> SVM pipeline (prediksi risiko dari nilai prediksi sensor)
            prediksi_risiko_status      TEXT,
            prediksi_risiko_confidence  REAL,

            -- Data CNN (tetap, dari deforestasi.json)
            status_deforestasi  TEXT,
            prob_deforestasi    REAL,

            -- ── Klasifikasi PER BENCANA (BARU) — masing-masing dari SVM sendiri ──
            -- Kebakaran (fitur: suhu, kelembapan)
            status_kebakaran        TEXT,
            confidence_kebakaran    REAL,
            prob_kebakaran_aman     REAL,
            prob_kebakaran_waspada  REAL,
            prob_kebakaran_siaga    REAL,
            prob_kebakaran_bahaya   REAL,

            -- Banjir (fitur: tinggi_air)
            status_banjir           TEXT,
            confidence_banjir       REAL,
            prob_banjir_aman        REAL,
            prob_banjir_waspada     REAL,
            prob_banjir_siaga       REAL,
            prob_banjir_bahaya      REAL,

            -- Pencemaran udara (fitur: pm1_0, pm2_5, pm10)
            status_pencemaran       TEXT,
            confidence_pencemaran   REAL,
            prob_pencemaran_aman    REAL,
            prob_pencemaran_waspada REAL,
            prob_pencemaran_siaga   REAL,
            prob_pencemaran_bahaya  REAL,

            -- Curah hujan (BARU) — threshold biasa; confidence & prediksi acak
            status_hujan            TEXT,
            confidence_hujan        REAL,
            prediksi_curah_hujan    REAL,
            prediksi_status_hujan   TEXT,

            -- Status pengiriman ke server (legacy, histori lokal)
            terkirim        INTEGER DEFAULT 0,  -- 0=belum, 1=sudah
            waktu_kirim     TEXT
        )
    """)

    # Tabel log pengiriman
    c.execute("""
        CREATE TABLE IF NOT EXISTS kirim_log (
            id          INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp   TEXT NOT NULL,
            target      TEXT,   -- 'predikta'
            status      TEXT,   -- 'sukses' / 'gagal'
            pesan       TEXT,
            n_data      INTEGER DEFAULT 0
        )
    """)

    conn.commit()

    # ── Migrasi kolom baru untuk database lama (mis. dari siprediksi.db lama) ──
    c.execute("PRAGMA table_info(sensor_log)")
    kolom_ada = [row[1] for row in c.fetchall()]
    if "co_mq7" not in kolom_ada:
        c.execute("ALTER TABLE sensor_log ADD COLUMN co_mq7 REAL")
        conn.commit()
        logging.info("Migrasi: kolom co_mq7 ditambahkan ke sensor_log")

    # Migrasi kolom BARU: lokasi + klasifikasi per bencana (kebakaran/banjir/
    # pencemaran udara), untuk database lama yang dibuat sebelum fitur ini ada.
    kolom_baru = {
        "lokasi"                : "TEXT DEFAULT 'ketapang'",
        "curah_hujan"           : "REAL",
        "status_hujan"          : "TEXT",
        "confidence_hujan"      : "REAL",
        "prediksi_curah_hujan"  : "REAL",
        "prediksi_status_hujan" : "TEXT",
        "status_kebakaran"      : "TEXT",
        "confidence_kebakaran"  : "REAL",
        "prob_kebakaran_aman"   : "REAL",
        "prob_kebakaran_waspada": "REAL",
        "prob_kebakaran_siaga"  : "REAL",
        "prob_kebakaran_bahaya" : "REAL",
        "status_banjir"         : "TEXT",
        "confidence_banjir"     : "REAL",
        "prob_banjir_aman"      : "REAL",
        "prob_banjir_waspada"   : "REAL",
        "prob_banjir_siaga"     : "REAL",
        "prob_banjir_bahaya"    : "REAL",
        "status_pencemaran"       : "TEXT",
        "confidence_pencemaran"   : "REAL",
        "prob_pencemaran_aman"    : "REAL",
        "prob_pencemaran_waspada" : "REAL",
        "prob_pencemaran_siaga"   : "REAL",
        "prob_pencemaran_bahaya"  : "REAL",
    }
    for kolom, tipe in kolom_baru.items():
        if kolom not in kolom_ada:
            c.execute(f"ALTER TABLE sensor_log ADD COLUMN {kolom} {tipe}")
            conn.commit()
            logging.info(f"Migrasi: kolom {kolom} ditambahkan ke sensor_log")

    c.execute("PRAGMA table_info(kirim_log)")
    kolom_kirim = [row[1] for row in c.fetchall()]
    if "target" not in kolom_kirim:
        c.execute("ALTER TABLE kirim_log ADD COLUMN target TEXT")
        conn.commit()
        logging.info("Migrasi: kolom target ditambahkan ke kirim_log")

    conn.close()


