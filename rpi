# STATE INTERNAL GENERATOR (dipertahankan antar siklus loop)
# ═══════════════════════════════════════════════════════════════════

class _StateSimulasi:
    """
    Menyimpan info yang perlu bertahan antar siklus loop simulasi.

    Posisi "random-walk" data sensor TIDAK LAGI disimpan di sini — sejak
    revisi ini, "data sensor" tiap siklus datang langsung dari baca_sensor()
    (real/dummy), bukan dari generator internal modul ini. Histori untuk
    forecast tetap diambil dari SQLite (ambil_buffer_lstm), sehingga
    kontinuitas antar-restart otomatis terjaga tanpa perlu logika resume
    terpisah.
    """

    def __init__(self, prob_defor):
        self.prob_defor        = prob_defor
        self.prediksi_terakhir = None   # forecast terakhir yang dihitung (utk referensi/tampilan)


# ═══════════════════════════════════════════════════════════════════
# FORECAST SINTETIS (bukan LSTM)
# ═══════════════════════════════════════════════════════════════════

def generate_prediksi_simulasi(buffer_terakhir, prob_defor, svm: "KlasifikasiUtama"):
    """
    Buat struktur prediksi sintetis semirip mungkin dengan output
    PrediksiLSTM.prediksi(), TANPA memanggil LSTM sama sekali:

        {"prediksi_nilai": {fitur: [...]}, "prediksi_status": [...]}

    Melanjutkan tren linier dari buffer_terakhir (TIMESTEP baris terakhir
    dari SQLite — histori ini sekarang berasal dari "data simulasi" yang
    sudah ditarik ke arah sensor real/dummy tiap siklus, lihat
    generate_data_simulasi()), dengan variasi kecil tiap horizon (tidak ada
    lonjakan ekstrem). tinggi_air & prob_deforestasi FIXED. Status/confidence
    per horizon diperoleh dari PrediksiSVM ASLI (bukan angka karangan).
    """
    prediksi_nilai = {f: [] for f in _FITUR_WALK}
    prediksi_nilai["tinggi_air"] = [0] * SIMULASI_HORIZON

    # Estimasi tren per fitur dari 2 baris terakhir buffer (kalau tersedia).
    tren = {}
    for fitur in _FITUR_WALK:
        if len(buffer_terakhir) >= 2:
            delta = buffer_terakhir[-1].get(fitur, 0) - buffer_terakhir[-2].get(fitur, 0)
        else:
            delta = 0.0
        batas_t = _BATAS_TREN.get(fitur, 5)
        tren[fitur] = max(-batas_t, min(batas_t, delta))

    titik = {f: buffer_terakhir[-1].get(f, _NILAI_AWAL[f]) for f in _FITUR_WALK}

    prediksi_status = []
    for h in range(SIMULASI_HORIZON):
        for fitur in _FITUR_WALK:
            skala_noise = 6.0 if fitur in ("pm1_0", "pm2_5", "pm10") else 1.0
            # Tarikan balik ringan ke titik tengah (_NILAI_AWAL) — mencegah
            # tren terus membesar/menurun tanpa batas antar-batch (mean-reversion).
            tarik_kembali = (_NILAI_AWAL[fitur] - titik[fitur]) * 0.08
            titik[fitur]  = titik[fitur] + tren[fitur] * 0.6 + tarik_kembali \
                            + random.gauss(0, 0.05) * skala_noise
            titik[fitur]  = _clamp(fitur, titik[fitur])
            prediksi_nilai[fitur].append(_bulatkan(fitur, titik[fitur]))

        # Paksa PM1.0 < PM2.5 < PM10 (maks 150) untuk horizon ini
        pm = {k: titik[k] for k in ("pm1_0", "pm2_5", "pm10")}
        _paksa_urutan_pm(pm)
        for k in ("pm1_0", "pm2_5", "pm10"):
            titik[k] = pm[k]
            prediksi_nilai[k][-1] = pm[k]

        # Klasifikasi horizon ini pakai SVM asli — confidence TIDAK dikarang manual
        titik_svm = {f: prediksi_nilai[f][h] for f in _FITUR_WALK}
        titik_svm["tinggi_air"] = 0
        hasil = svm.prediksi(titik_svm, prob_defor) if svm else None
        prediksi_status.append(hasil["status"] if hasil else "?")

    logging.info(f"[A2] Generate prediksi H+1 sampai H+{SIMULASI_HORIZON} (generator sintetis, BUKAN LSTM)")

    return {
        "prediksi_nilai" : prediksi_nilai,
        "prediksi_status": prediksi_status,
    }


# ═══════════════════════════════════════════════════════════════════
# "DATA SIMULASI" — prediksi ditarik ke arah data sensor real/dummy
# ═══════════════════════════════════════════════════════════════════

def generate_data_simulasi(data_sensor_asli: dict, target: dict,
                            fitur_list=None, batas_dict=None):
    """
    Hitung "data simulasi" (nilai aktual yang dilaporkan) per fitur, dengan
    menarik nilai `target` (forecast H+1 dari generate_prediksi_simulasi)
    ke ARAH `data_sensor_asli[fitur]` (pembacaan sensor real/dummy siklus
    ini, dari baca_sensor()) — BUKAN lagi ke arah acak.

    Algoritma per fitur:
        1. akurasi  = generate_akurasi_baru()   -> 0.50 - 0.99 (5 pita)
        2. deviasi  = abs(prediksi) * (1 - akurasi)
           (akurasi = 1 - abs(simulasi - prediksi) / abs(prediksi), lihat
           formula terbalik di atas — makin tinggi akurasi, makin kecil
           deviasi terhadap prediksi)
        3. arah     = menuju data_sensor_asli (naik kalau sensor > prediksi,
           turun kalau sensor < prediksi) — supaya rentang data simulasi
           mengikuti rentang data sensor AKTUAL, bukan arah acak.
        4. deviasi DIBATASI supaya tidak melewati jarak prediksi->sensor,
           jadi hasil akhir SELALU berada di antara prediksi & sensor
           (lihat contoh pola di docstring modul).
        5. Hasil akhir tetap di-clamp ke rentang realistis fitur (_BATAS_NILAI).
        6. (BARU) Setelah semua fitur selesai, PM dipaksa berurutan
           PM1.0 < PM2.5 < PM10 dan <= 150 lewat _paksa_urutan_pm().

    Return dict {fitur: nilai} MURNI NUMERIK — TIDAK menambahkan field
    non-numerik (tinggi_air, co_mq7, sumber, timestamp); itu tanggung jawab
    caller (generate_baris_simulasi).
    """
    fitur_list = fitur_list or _FITUR_WALK
    batas_dict = batas_dict or _BATAS_NILAI

    hasil = {}
    for fitur in fitur_list:
        nilai_prediksi = target[fitur]
        nilai_sensor   = data_sensor_asli.get(fitur)
        if nilai_sensor is None:
            # Sensor fitur ini gagal dibaca (nilai None) -> pakai nilai prediksi,
            # jadi tidak ada tarikan ke arah sensor (deviasi = 0).
            logging.warning(f"[A2] Sensor '{fitur}' None, pakai nilai prediksi")
            nilai_sensor = nilai_prediksi

        akurasi = generate_akurasi_baru()
        deviasi = abs(nilai_prediksi) * (1 - akurasi)

        jarak_ke_sensor = abs(nilai_sensor - nilai_prediksi)
        deviasi = min(deviasi, jarak_ke_sensor)   # jangan pernah melewati nilai sensor asli

        arah       = 1 if nilai_sensor >= nilai_prediksi else -1
        nilai_baru = nilai_prediksi + arah * deviasi

        hasil[fitur] = _bulatkan(fitur, _clamp(fitur, nilai_baru, batas_dict))

    _paksa_urutan_pm(hasil)
    return hasil


# ═══════════════════════════════════════════════════════════════════
# GENERATOR SATU BARIS — dipanggil tiap siklus loop simulasi
# ═══════════════════════════════════════════════════════════════════

def generate_baris_simulasi(state: "_StateSimulasi", svm: "KlasifikasiUtama"):
    """
    Hasilkan satu baris data untuk siklus mode simulasi saat ini.

    ALUR (baca sensor dulu, baru simulasikan nilainya — lihat docstring
    modul ini):
      1. baca_sensor() dipanggil LEBIH DULU — data sensor real/dummy siklus
         ini (bisa None kalau semua sensor inti gagal di mode nyata, sama
         seperti main.py).
      2. Kalau histori SQLite belum cukup TIMESTEP baris -> laporkan
         pembacaan sensor apa adanya (belum ada forecast pembanding).
      3. Kalau sudah cukup -> hitung forecast fresh (generate_prediksi_
         simulasi), lalu tarik forecast H+1 ke arah pembacaan sensor tadi
         (generate_data_simulasi) untuk mendapat "data simulasi" akhir.

    Return (data_final, hasil_prediksi_untuk_disimpan_atau_None, ada_forecast)
        data_final: None kalau semua sensor inti gagal dibaca (siklus
                    dilewati oleh caller, sama seperti main.py).
    """
    data_sensor = baca_sensor()
    _catat_sensor_aktual(data_sensor)   # BARU: hanya untuk panel status sensor (tidak memengaruhi data)
    if data_sensor is None:
        return None, None, False

    data_sensor["tinggi_air"] = 0          # FIXED, lihat docstring modul ini
    data_sensor["sumber"]     = "simulasi"

    buffer = ambil_buffer_lstm(TIMESTEP)
    if not buffer:
        # Histori belum cukup untuk membuat forecast -> laporkan pembacaan
        # sensor apa adanya, tidak ada yang bisa "disimulasikan" dulu.
        data_sensor["co_mq7"] = None
        logging.info(
            f"[A2] Histori belum cukup untuk forecast — pakai "
            f"pembacaan sensor apa adanya ({hitung_total()}/{TIMESTEP})"
        )
        return data_sensor, None, False

    hasil_prediksi_baru     = generate_prediksi_simulasi(buffer, state.prob_defor, svm)
    state.prediksi_terakhir = hasil_prediksi_baru

    target_h1  = {f: hasil_prediksi_baru["prediksi_nilai"][f][0] for f in _FITUR_WALK}
    data_final = generate_data_simulasi(data_sensor, target_h1)

    data_final["tinggi_air"] = 0
    data_final["co_mq7"]     = None
    data_final["curah_hujan"] = data_sensor.get("curah_hujan")   # DATA REAL sensor hujan, apa adanya
    data_final["sumber"]     = "simulasi"
    data_final["timestamp"]  = datetime.now().isoformat()

    logging.info("[A2] Data A2 dihitung dari forecast + pembacaan A1 (sensor real/dummy)")
    return data_final, hasil_prediksi_baru, True


# ═══════════════════════════════════════════════════════════════════
# STATUS SENSOR AKTUAL (BARU) — panel terminal untuk cek berkala
# ═══════════════════════════════════════════════════════════════════
# HANYA TAMPILAN (+ catatan log saat status berubah). Tidak mengubah data
# yang disimpan ke SQLite maupun yang dikirim ke server. Pembacaan sensor
# MENTAH disalin di generate_baris_simulasi() sebelum disimulasikan, lalu
# ditampilkan di sebelah data simulasi (data yang benar-benar dikirim).
#
# Status per sensor (dinilai dari nilai yang terbaca, bukan dari hardware):
#   OK        semua nilai sensor terbaca
#   SEBAGIAN  sebagian nilai terbaca (khusus PMS5003T: PM1.0/PM2.5/PM10)
#   GAGAL     tidak ada nilai yang terbaca (None) — mis. sensor kecabut
#   DUMMY     MODE_DUMMY aktif -> data bukan dari sensor fisik

_SENSOR_AKTUAL  = {}   # salinan pembacaan sensor mentah siklus terakhir
_STATUS_SENSOR  = {}   # nama sensor -> status siklus terakhir
_GAGAL_BERTURUT = {}   # nama sensor -> jumlah siklus berturut-turut gagal/sebagian

# (nama sensor, [(fitur, label, satuan), ...])
_PANEL_SENSOR = [
    ("DS18B20",  [("suhu", "suhu", "°C")]),
    ("SHT31",    [("kelembapan", "kelembapan", "%RH")]),
    ("PMS5003T", [("pm1_0", "PM1.0", "µg/m³"),
                  ("pm2_5", "PM2.5", "µg/m³"),
                  ("pm10",  "PM10",  "µg/m³")]),
]


def _catat_sensor_aktual(data_sensor):
    """Salin pembacaan sensor mentah + hitung status tiap sensor. Tidak pernah melempar error."""
    try:
        data = dict(data_sensor) if data_sensor else {}
        _SENSOR_AKTUAL.clear()
        _SENSOR_AKTUAL.update(data)
        dummy = data.get("sumber") == "dummy"

        for nama, daftar in _PANEL_SENSOR:
            terbaca = [data.get(fitur) is not None for fitur, _, _ in daftar]
            if dummy:
                status = "DUMMY"
            elif all(terbaca):
                status = "OK"
            elif any(terbaca):
                status = "SEBAGIAN"
            else:
                status = "GAGAL"

            if status in ("GAGAL", "SEBAGIAN"):
                _GAGAL_BERTURUT[nama] = _GAGAL_BERTURUT.get(nama, 0) + 1
            else:
                _GAGAL_BERTURUT[nama] = 0

            sebelumnya = _STATUS_SENSOR.get(nama)
            if sebelumnya is not None and sebelumnya != status:
                logging.warning(f"[SENSOR] {nama}: status berubah {sebelumnya} -> {status}")
            _STATUS_SENSOR[nama] = status
    except Exception as e:
        logging.error(f"[SENSOR] Gagal mencatat status sensor: {e}")


def _tampilkan_panel_sensor(data_simulasi):
    """Tampilkan status sensor + data A1 berdampingan dengan data A2. Tidak pernah melempar error."""
    try:
        warna_status = {"OK": HIJAU, "SEBAGIAN": KUNING, "GAGAL": MERAH2, "DUMMY": KUNING}
        ada_tanda    = False

        print(f"\n    {BOLD}STATUS SENSOR{RESET}  "
              f"{ABU}(A1 = pembacaan sensor | A2 = data yang disimpan/dikirim){RESET}")
        print(f"    {'Sensor':<10}{'Status':<10}{'Data':<12}{'A1':>17}{'A2':>11}{'Selisih':>10}")

        for nama, daftar in _PANEL_SENSOR:
            status = _STATUS_SENSOR.get(nama, "?")
            warna  = warna_status.get(status, RESET)
            for i, (fitur, label, satuan) in enumerate(daftar):
                aktual = _SENSOR_AKTUAL.get(fitur)
                sim    = data_simulasi.get(fitur) if data_simulasi else None

                txt_aktual = f"{aktual} {satuan}" if aktual is not None else "tidak terbaca"
                txt_sim    = "-" if sim is None else str(sim)
                if aktual is None and sim is not None:
                    txt_sim  += "*"      # nilai simulasi diisi forecast karena sensor tidak terbaca
                    ada_tanda = True
                if aktual is not None and sim is not None:
                    txt_selisih = f"{sim - aktual:+.2f}"
                else:
                    txt_selisih = "-"

                kolom_nama   = f"{nama:<10}" if i == 0 else " " * 10
                kolom_status = f"{warna}{BOLD}{status:<10}{RESET}" if i == 0 else " " * 10
                print(f"    {kolom_nama}{kolom_status}{label:<12}{txt_aktual:>17}{txt_sim:>11}{txt_selisih:>10}")

        for nama, _ in _PANEL_SENSOR:
            n = _GAGAL_BERTURUT.get(nama, 0)
            if n > 0:
                print(f"    {MERAH}⚠ {nama} bermasalah (tidak terbaca) selama {n} siklus berturut-turut — cek kabel/sensor{RESET}")
        if ada_tanda:
            print(f"    {ABU}* nilai A2 diisi dari forecast karena sensor tidak terbaca{RESET}")
        if any(v == "DUMMY" for v in _STATUS_SENSOR.values()):
            print(f"    {ABU}MODE_DUMMY aktif: nilai 'A1' berasal dari generator dummy, bukan sensor fisik{RESET}")
    except Exception as e:
        logging.error(f"[SENSOR] Gagal menampilkan panel sensor: {e}")


