def ambil_deforestasi_fixed():
    """
    Ambil data CNN dari deforestasi.json (via DataCNN, sama seperti mode
    normal) supaya nilai FIXED simulasi tetap bersumber dari file asli,
    bukan angka acak. Kalau file tidak ada/rusak, DataCNN sendiri sudah
    punya fallback (prob_deforestasi=0.0) — kita timpa fallback itu jadi
    0.317 sesuai contoh pola yang diminta, supaya mode simulasi tetap
    bisa jalan walau deforestasi.json belum di-setup.
    """
    try:
        data = DataCNN().get()
        if data.get("prob_deforestasi") in (None, 0.0) and \
           data.get("status_deforestasi") in ("Tidak Diketahui", "Error"):
            logging.warning("[A2] deforestasi.json belum ada/rusak, pakai fallback prob_deforestasi=0.317")
            data = dict(data)
            data["prob_deforestasi"] = 0.317
        return data
    except Exception as e:
        logging.warning(f"[A2] Gagal ambil deforestasi.json, pakai fallback 0.317: {e}")
        return {"status_deforestasi": "Tidak Diketahui", "prob_deforestasi": 0.317}


# ═══════════════════════════════════════════════════════════════════
# DISTRIBUSI AKURASI — 5 PITA (prediksi vs simulasi)
# ═══════════════════════════════════════════════════════════════════

def generate_akurasi_baru(pita=None):
    """
    Sampling akurasi (0-1) dari distribusi 5-pita SIMULASI_PREDIKTA_AKURASI
    (lihat config.py):
        10% di 50%-60%, 10% di 60%-70%, 20% di 70%-80%,
        40% di 80%-90%, 20% di 90%-99%.

    Cara kerja: pilih satu pita secara acak sesuai bobot probabilitasnya
    (probabilitas kumulatif), lalu ambil UNIFORM dari rentang pita itu.

    Return: float akurasi (0-1, mis. 0.91 = 91%).
    """
    pita = pita or SIMULASI_PREDIKTA_AKURASI
    r = random.random()
    kumulatif = 0.0
    for lo, hi, prob in pita:
        kumulatif += prob
        if r <= kumulatif:
            return random.uniform(lo, hi)
    # Fallback jaga-jaga (mis. total probabilitas < 1.0 karena salah config)
    lo, hi, _ = pita[-1]
    return random.uniform(lo, hi)


def cek_distribusi_akurasi(pita=None, n: int = 10000):
    """
    Utilitas debug/validasi manual (TIDAK dipanggil otomatis di alur
    simulasi): generate `n` sampel akurasi dari generate_akurasi_baru(pita),
    lalu hitung berapa persen yang jatuh di tiap pita, untuk memverifikasi
    hasil generate benar-benar mendekati proporsi yang diminta.

    Contoh pemakaian manual dari shell:
        python3 -c "import simulasi; simulasi.cek_distribusi_akurasi()"
    """
    pita  = pita or SIMULASI_PREDIKTA_AKURASI
    nilai = [generate_akurasi_baru(pita) for _ in range(n)]

    print(f"n={n}  min={min(nilai):.4f}  max={max(nilai):.4f}  rata2={sum(nilai)/n:.4f}")
    for lo, hi, prob_target in pita:
        jumlah = sum(1 for a in nilai if lo <= a <= hi)
        persen = jumlah / n * 100
        print(f"Di pita [{lo:.2f}, {hi:.2f}]: {persen:5.1f}%  (target: {prob_target*100:.0f}%)")


