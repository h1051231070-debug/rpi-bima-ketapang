try:
    import requests
    REQUESTS_OK = True
except ImportError:
    REQUESTS_OK = False


def cek_koneksi():
    """Cek apakah ada koneksi internet."""
    if not REQUESTS_OK:
        return False
    try:
        r = requests.get("https://1.1.1.1", timeout=5)
        return r.status_code == 200
    except Exception:
        return False


