def simpan_data(data_sensor, hasil_svm, hasil_lstm, data_defor, hasil_prediksi_risiko=None,
                 hasil_kebakaran=None, hasil_banjir=None, hasil_pencemaran=None,
                 hasil_hujan=None):
    """
    Simpan satu baris pembacaan lengkap ke SQLite.

    Parameter:
        data_sensor             : dict dari sensor.py (termasuk co_mq7 jika ada)
        hasil_svm               : dict {status, confidence, prob_aman, ...} (SVM umum)
        hasil_lstm              : dict {prediksi_nilai, prediksi_status}
                                  atau None jika belum cukup data
        data_defor              : dict dari deforestasi.json
        hasil_prediksi_risiko   : dict {status, confidence} dari LSTM -> SVM pipeline
        hasil_kebakaran         : dict {status, confidence, prob} dari SVM kebakaran (BARU)
        hasil_banjir            : dict {status, confidence, prob} dari SVM banjir (BARU)
        hasil_pencemaran        : dict {status, confidence, prob} dari SVM pencemaran udara (BARU)
        hasil_hujan             : dict {status, confidence, prediksi_nilai, prediksi_status} dari
                                  prediksi.analisis_hujan() (BARU; threshold + acak, bukan model)

    Return: id baris yang baru disimpan (dipakai untuk korelasi log, opsional).
    """
    conn = sqlite3.connect(DB_PATH)
    c    = conn.cursor()

    # Serialisasi prediksi LSTM ke JSON
    pred_nilai  = json.dumps(hasil_lstm.get("prediksi_nilai"))  if hasil_lstm else None
    pred_status = json.dumps(hasil_lstm.get("prediksi_status")) if hasil_lstm else None

    hasil_kebakaran  = hasil_kebakaran  or {}
    hasil_banjir     = hasil_banjir     or {}
    hasil_pencemaran = hasil_pencemaran or {}
    hasil_hujan      = hasil_hujan      or {}

    c.execute("""
        INSERT INTO sensor_log (
            timestamp, lokasi, suhu, kelembapan, pm1_0, pm2_5, pm10,
            tinggi_air, co_mq7, sumber,
            status_risiko, confidence_svm,
            prob_aman, prob_waspada, prob_siaga, prob_bahaya,
            prediksi_nilai, prediksi_status,
            prediksi_risiko_status, prediksi_risiko_confidence,
            status_deforestasi, prob_deforestasi,
            status_kebakaran, confidence_kebakaran,
            prob_kebakaran_aman, prob_kebakaran_waspada, prob_kebakaran_siaga, prob_kebakaran_bahaya,
            status_banjir, confidence_banjir,
            prob_banjir_aman, prob_banjir_waspada, prob_banjir_siaga, prob_banjir_bahaya,
            status_pencemaran, confidence_pencemaran,
            prob_pencemaran_aman, prob_pencemaran_waspada, prob_pencemaran_siaga, prob_pencemaran_bahaya,
            curah_hujan, status_hujan, confidence_hujan, prediksi_curah_hujan, prediksi_status_hujan
        ) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,
                  ?,?,?,?,?,?,
                  ?,?,?,?,?,?,
                  ?,?,?,?,?,?,
                  ?,?,?,?,?)
    """, (
        data_sensor.get("timestamp"),
        LOKASI,
        data_sensor.get("suhu"),
        data_sensor.get("kelembapan"),
        data_sensor.get("pm1_0"),
        data_sensor.get("pm2_5"),
        data_sensor.get("pm10"),
        data_sensor.get("tinggi_air"),
        data_sensor.get("co_mq7"),
        data_sensor.get("sumber", "sensor"),
        hasil_svm.get("status"),
        hasil_svm.get("confidence"),
        hasil_svm.get("prob", {}).get("Aman"),
        hasil_svm.get("prob", {}).get("Waspada"),
        hasil_svm.get("prob", {}).get("Siaga"),
        hasil_svm.get("prob", {}).get("Bahaya"),
        pred_nilai,
        pred_status,
        hasil_prediksi_risiko.get("status") if hasil_prediksi_risiko else None,
        hasil_prediksi_risiko.get("confidence") if hasil_prediksi_risiko else None,
        data_defor.get("status_deforestasi"),
        data_defor.get("prob_deforestasi"),
        hasil_kebakaran.get("status"),
        hasil_kebakaran.get("confidence"),
        hasil_kebakaran.get("prob", {}).get("Aman"),
        hasil_kebakaran.get("prob", {}).get("Waspada"),
        hasil_kebakaran.get("prob", {}).get("Siaga"),
        hasil_kebakaran.get("prob", {}).get("Bahaya"),
        hasil_banjir.get("status"),
        hasil_banjir.get("confidence"),
        hasil_banjir.get("prob", {}).get("Aman"),
        hasil_banjir.get("prob", {}).get("Waspada"),
        hasil_banjir.get("prob", {}).get("Siaga"),
        hasil_banjir.get("prob", {}).get("Bahaya"),
        hasil_pencemaran.get("status"),
        hasil_pencemaran.get("confidence"),
        hasil_pencemaran.get("prob", {}).get("Aman"),
        hasil_pencemaran.get("prob", {}).get("Waspada"),
        hasil_pencemaran.get("prob", {}).get("Siaga"),
        hasil_pencemaran.get("prob", {}).get("Bahaya"),
        data_sensor.get("curah_hujan"),
        hasil_hujan.get("status"),
        hasil_hujan.get("confidence"),
        hasil_hujan.get("prediksi_nilai"),
        hasil_hujan.get("prediksi_status"),
    ))

    last_id = c.lastrowid
    conn.commit()
    conn.close()
    return last_id


