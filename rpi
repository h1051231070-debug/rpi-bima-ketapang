# PREDIKSI LSTM (FIXED)
# ═══════════════════════════════════════════════════════════════════

class PrediksiLSTM:
    """
    Load model LSTM TFLite dan lakukan prediksi time series.
    Mengelola buffer internal dari data historis SQLite.

    FIXES applied:
    1. except ImportError -> except Exception (ValueError/OSError/etc juga catch)
    2. Fallback tflite_runtime -> ai_edge_litert -> tensorflow (3 blok try terpisah),
       karena tflite-runtime klasik tidak tersedia untuk Python 3.12/3.13.
    3. Scaler/encoder hanya diload jika interpreter OK
    4. Deteksi otomatis index output nilai vs status berdasarkan rank shape,
       karena TFLite tidak menjamin urutan output_details sesuai urutan training,
       dan N_TARGET kebetulan bisa sama panjang dengan N_KELAS (potensi tertukar diam-diam).
    5. Pengaman reshape jika out_nilai ternyata 1D.
    """

    def __init__(self):
        self.interpreter = None
        self.scaler_in   = None
        self.scaler_out  = None
        self.encoder     = None
        self.input_details = None
        self.output_details = None
        self.idx_nilai  = None
        self.idx_status = None
        self._load()

    def _load(self):
        import joblib
        interpreter_ok = False

        # -- Coba tflite_runtime dulu (Python <=3.11) --
        try:
            import tflite_runtime.interpreter as tflite
            self.interpreter = tflite.Interpreter(model_path=MODEL_LSTM)
            self.interpreter.allocate_tensors()
            self.input_details  = self.interpreter.get_input_details()
            self.output_details = self.interpreter.get_output_details()
            interpreter_ok = True
            logging.info("LSTM OK via tflite_runtime")
        except Exception as e:
            logging.warning(f"LSTM tflite_runtime gagal: {e}, coba ai-edge-litert...")

        # -- Fallback ke ai-edge-litert (penerus tflite-runtime, support Python 3.12/3.13) --
        if not interpreter_ok:
            try:
                from ai_edge_litert.interpreter import Interpreter as LiteRTInterpreter
                self.interpreter = LiteRTInterpreter(model_path=MODEL_LSTM)
                self.interpreter.allocate_tensors()
                self.input_details  = self.interpreter.get_input_details()
                self.output_details = self.interpreter.get_output_details()
                interpreter_ok = True
                logging.info("LSTM OK via ai_edge_litert")
            except Exception as e:
                logging.warning(f"LSTM ai_edge_litert gagal: {e}, coba tensorflow...")

        # -- Fallback ke TensorFlow penuh --
        if not interpreter_ok:
            try:
                import tensorflow as tf
                self.interpreter = tf.lite.Interpreter(model_path=MODEL_LSTM)
                self.interpreter.allocate_tensors()
                self.input_details  = self.interpreter.get_input_details()
                self.output_details = self.interpreter.get_output_details()
                interpreter_ok = True
                logging.info("LSTM OK via tensorflow")
            except Exception as e:
                logging.error(f"LSTM tensorflow juga gagal: {e}")
                self.interpreter = None
                return

        # -- Load scaler & encoder --
        try:
            self.scaler_in  = joblib.load(SCALER_LSTM)
            self.scaler_out = joblib.load(SCALER_TARGET)
            self.encoder    = joblib.load(ENCODER_LSTM)
            logging.info("LSTM scaler & encoder OK")
        except Exception as e:
            logging.error(f"LSTM scaler/encoder gagal: {e}")
            self.scaler_in  = None
            self.scaler_out = None
            self.encoder    = None

        # -- Deteksi otomatis index output nilai vs status --
        # Output "nilai" berbentuk 3D (1, HORIZON, N_TARGET), output "status"
        # berbentuk 2D (1, N_KELAS). Kita bedakan dari rank shape, bukan index tetap,
        # karena N_TARGET dan N_KELAS bisa kebetulan sama panjang (mis. sama-sama 4)
        # sehingga tidak bisa dibedakan hanya dari panjangnya.
        if interpreter_ok and self.output_details:
            for i, det in enumerate(self.output_details):
                if len(det["shape"]) >= 3:
                    self.idx_nilai = i
                elif len(det["shape"]) == 2:
                    self.idx_status = i
            if self.idx_nilai is None or self.idx_status is None:
                logging.warning(
                    f"LSTM: tidak bisa deteksi otomatis index output "
                    f"(shapes={[d['shape'] for d in self.output_details]}), "
                    f"pakai default [0]=nilai, [1]=status"
                )
                self.idx_nilai  = 0
                self.idx_status = 1
            else:
                logging.info(
                    f"LSTM: output nilai=index {self.idx_nilai}, "
                    f"output status=index {self.idx_status}"
                )

    def prediksi(self, buffer_data: list):
        """
        Prediksi nilai sensor & status risiko ke depan.

        Parameter:
            buffer_data: list of dict, panjang = TIMESTEP
                         [{suhu, kelembapan, pm1_0, pm2_5, pm10, tinggi_air}, ...]

        Return:
            dict {prediksi_nilai, prediksi_status} atau None jika gagal
        """
        if self.interpreter is None or len(buffer_data) < TIMESTEP:
            return None
        if self.scaler_in is None or self.scaler_out is None or self.encoder is None:
            logging.error("LSTM prediksi gagal: scaler/encoder None")
            return None
        try:
            # Susun array input (TIMESTEP, N_FITUR)
            X = np.array(
                [[row[f] for f in FITUR_INPUT] for row in buffer_data],
                dtype=np.float32
            )
            X_scaled = self.scaler_in.transform(X)
            X_batch  = X_scaled[np.newaxis, ...]   # (1, TIMESTEP, N_FITUR)

            # Inferensi TFLite
            self.interpreter.set_tensor(
                self.input_details[0]["index"], X_batch
            )
            self.interpreter.invoke()

            # Output nilai: (1, HORIZON, N_TARGET) - index dideteksi otomatis di _load()
            out_nilai  = self.interpreter.get_tensor(
                self.output_details[self.idx_nilai]["index"]
            )[0]

            # Output status: (1, N_KELAS) - index dideteksi otomatis di _load()
            out_status = self.interpreter.get_tensor(
                self.output_details[self.idx_status]["index"]
            )[0]

            # Pengaman tambahan: pastikan out_nilai 2D (HORIZON, N_TARGET)
            # sebelum inverse_transform, kalau-kalau shape model tidak sesuai dugaan.
            out_nilai = np.asarray(out_nilai)
            if out_nilai.ndim == 1:
                out_nilai = out_nilai.reshape(HORIZON, len(FITUR_TARGET))

            # Inverse transform nilai sensor
            pred_nilai_nyata = self.scaler_out.inverse_transform(out_nilai)

            # Format prediksi nilai per fitur
            prediksi_nilai = {}
            for j, fitur in enumerate(FITUR_TARGET):
                prediksi_nilai[fitur] = [
                    round(float(pred_nilai_nyata[h][j]), 2)
                    for h in range(HORIZON)
                ]

            # Decode status risiko per horizon
            prediksi_status = [
                self.encoder.inverse_transform(
                    [np.argmax(out_status)]
                )[0]
            ] * HORIZON

            return {
                "prediksi_nilai" : prediksi_nilai,
                "prediksi_status": prediksi_status,
            }

        except Exception as e:
            logging.error(f"LSTM prediksi error: {e}")
            return None


