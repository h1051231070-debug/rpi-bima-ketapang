# KLASIFIKASI UTAMA (BARU) — pengganti PrediksiSVM umum
# ═══════════════════════════════════════════════════════════════════

class KlasifikasiUtama:
    """
    Klasifikasi risiko utama berbasis skor tertimbang (tanpa model .pkl).

    1. Tiap parameter -> level 0..3 lewat THRESHOLD_UTAMA.
    2. Bobot efektif: parameter yang level-nya Bahaya dikali PENGGANDA_BAHAYA (2x),
       parameter None (sensor gagal) dilewati, lalu semua bobot dinormalisasi ulang
       ke total 1.0 (bobot parameter lain otomatis turun).
       skor = jumlah(bobot_efektif[f] x level[f])
    3. Status = skor dibulatkan ke level terdekat (SKOR_BATAS_UTAMA).
    4. Confidence makin tinggi kalau skor makin dekat ke pusat level statusnya.
       Skor untuk confidence dihitung KONTINU (posisi nilai sensor di dalam rentang
       levelnya, lihat _level_kontinu), sehingga persentase ikut bergerak mengikuti
       nilai sensor. STATUS tetap dari level diskrit + THRESHOLD_UTAMA (tidak berubah).

    Antarmuka sama dengan PrediksiSVM: prediksi(data_sensor, prob_defor=None)
    -> {status, confidence, prob} (+ "skor" dan "level" sebagai info tambahan).
    prob_defor diabaikan (deforestasi tidak termasuk dalam bobot).
    """

    SEVERITAS = KELAS_RISIKO   # ["Aman", "Waspada", "Siaga", "Bahaya"]

    def __init__(self):
        self.nama  = "utama"
        self.fitur = list(BOBOT_UTAMA.keys())
        self.model = "threshold"   # bukan None -> kompatibel dgn pengecekan "model dimuat"

    def _level(self, nilai, rentang):
        for status, lo, hi in rentang:
            if (lo is None or nilai >= lo) and (hi is None or nilai < hi):
                return self.SEVERITAS.index(status)
        return None

    def _level_kontinu(self, nilai, rentang):
        """
        Level KONTINU (0..3) dari satu nilai sensor — HANYA untuk confidence.
        Batas antar-level sama persis dgn _level() / THRESHOLD_UTAMA:
          - pusat rentang level  -> tepat L (mis. Waspada = 1.0)
          - di batas dgn tetangga -> tengah-tengah L dan level tetangga (mis. 0.5 / 1.5)
        Jadi level kontinu selalu berada dalam +-0.5 dari level diskritnya, dan
        bergerak mulus ketika nilai sensor berubah (tanpa loncat di batas).
        Kelas terbuka (None) memakai lebar kelas tetangga sebagai acuan skala,
        sama seperti KlasifikasiThreshold.
        """
        idx = None
        for i, (status, lo, hi) in enumerate(rentang):
            if (lo is None or nilai >= lo) and (hi is None or nilai < hi):
                idx = i
                break
        if idx is None:
            return None
        status, lo, hi = rentang[idx]
        L = self.SEVERITAS.index(status)

        if lo is not None and hi is not None:
            setengah = (hi - lo) / 2.0
            tengah   = (lo + hi) / 2.0
        else:
            if lo is None:
                tg = rentang[idx + 1] if idx + 1 < len(rentang) else None
            else:
                tg = rentang[idx - 1] if idx - 1 >= 0 else None
            lebar = (tg[2] - tg[1]) if (tg and tg[1] is not None and tg[2] is not None) else 1.0
            setengah = lebar if lebar > 0 else 1.0
            tengah   = (hi - setengah) if lo is None else (lo + setengah)

        d = min(abs(nilai - tengah) / setengah, 1.0) if setengah > 0 else 0.0

        # tetangga di sisi tempat nilai berada (sisi bawah / atas dari pusat)
        if nilai < tengah:
            nb = rentang[idx - 1] if idx - 1 >= 0 else None
        else:
            nb = rentang[idx + 1] if idx + 1 < len(rentang) else None
        L_nb = self.SEVERITAS.index(nb[0]) if nb else L

        return L + d * (L_nb - L) / 2.0

    def prediksi(self, data_sensor: dict, prob_defor: float = None):
        try:
            level = {}
            level_k = {}   # level kontinu (khusus confidence)
            for f in self.fitur:
                nilai = data_sensor.get(f)
                if nilai is None:
                    continue
                if f == "tinggi_air":
                    nilai = nilai * TINGGI_AIR_CM_KE_M
                lv = self._level(nilai, THRESHOLD_UTAMA[f])
                if lv is not None:
                    level[f] = lv
                    level_k[f] = self._level_kontinu(nilai, THRESHOLD_UTAMA[f])
            if not level:
                return None

            # Bobot efektif: parameter level Bahaya (3) dikali PENGGANDA_BAHAYA, lalu
            # dinormalisasi ulang (total 1.0) sehingga bobot parameter lain berkurang.
            idx_bahaya = len(self.SEVERITAS) - 1
            mentah = {f: BOBOT_UTAMA[f] * (PENGGANDA_BAHAYA if lv == idx_bahaya else 1.0)
                      for f, lv in level.items()}
            total_bobot = sum(mentah.values())
            bobot_efektif = {f: w / total_bobot for f, w in mentah.items()}
            skor = sum(bobot_efektif[f] * lv for f, lv in level.items())

            idx    = sum(1 for b in SKOR_BATAS_UTAMA if skor >= b)
            status = self.SEVERITAS[idx]

            # Confidence: dari skor KONTINU (bergerak mengikuti nilai sensor), bobot sama.
            # Status di atas tetap dari skor diskrit -> threshold tidak berubah.
            skor_k = sum(bobot_efektif[f] * level_k[f] for f in level_k)
            frac       = 1.0 - min(abs(skor_k - idx) / 0.5, 1.0)
            confidence = BENCANA_CONF_MIN + frac * (BENCANA_CONF_MAX - BENCANA_CONF_MIN)

            sisa  = 100.0 - confidence
            bobot = {s: 1.0 / (1 + abs(self.SEVERITAS.index(s) - idx))
                     for s in self.SEVERITAS if s != status}
            tot   = sum(bobot.values())
            prob  = {s: round(sisa * w / tot, 2) for s, w in bobot.items()}
            prob[status] = round(confidence, 2)

            return {
                "status"    : status,
                "confidence": round(confidence, 2),
                "prob"      : prob,
                "skor"      : round(skor, 3),
                "skor_kontinu": round(skor_k, 3),
                "level"     : {f: self.SEVERITAS[lv] for f, lv in level.items()},
                "bobot"     : {f: round(w, 4) for f, w in bobot_efektif.items()},
            }
        except Exception as e:
            logging.error(f"Klasifikasi utama error: {e}")
            return None


