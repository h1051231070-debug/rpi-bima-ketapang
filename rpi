def tampilkan_hasil(path_gambar, ukuran, kelas, prob_defor, prob_forest, status):
    """Tampilkan hasil di terminal."""
    warna = WARNA_STATUS.get(status, RESET)
    emoji = EMOJI_STATUS.get(status, "")
    pct_d = prob_defor  * 100
    pct_f = prob_forest * 100

    def bar(pct, w):
        n = int(pct / 2.5)
        return f"{w}{'█'*n}{RESET}{'░'*(40-n)}"

    print(f"\n  {'─'*54}")
    print(f"  File    : {os.path.basename(path_gambar)}")
    print(f"  Ukuran  : {ukuran[0]}×{ukuran[1]} px {ABU}→ resize 224×224{RESET}")
    print(f"  {'─'*54}")
    print(f"\n  {BOLD}Prediksi : {'DEFORESTATION' if kelas=='deforestation' else 'FOREST'}{RESET}")
    print(f"\n  Probabilitas:")
    print(f"    {MERAH2}Deforestation{RESET}  {bar(pct_d, MERAH2)} {pct_d:5.1f}%")
    print(f"    {HIJAU}Forest       {RESET}  {bar(pct_f, HIJAU)} {pct_f:5.1f}%")
    print(f"\n  {'─'*54}")
    print(f"  Status Deforestasi : {emoji} {warna}{BOLD}{status}{RESET}")
    print(f"  {'─'*54}")


def simpan_hasil(path_gambar, kelas, prob_defor, prob_forest, status):
    """
    Simpan hasil ke deforestasi.json di folder data/.
    File ini dibaca oleh main.py setiap siklus sebagai nilai tetap.
    """
    os.makedirs(DATA_DIR, exist_ok=True)

    hasil = {
        "file_gambar"        : os.path.basename(path_gambar),
        "kelas"              : kelas,
        "prob_deforestasi"   : round(prob_defor,  4),
        "prob_forest"        : round(prob_forest, 4),
        "status_deforestasi" : status,
        "waktu_proses"       : datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "threshold_tinggi"   : THRESHOLD_TINGGI,
        "threshold_sedang"   : THRESHOLD_SEDANG,
        "catatan"            : "Diproses saat instalasi di lapangan. Nilai permanen selama operasional.",
    }

    with open(DEFOR_PATH, "w") as f:
        json.dump(hasil, f, indent=2)

    print(f"\n  {HIJAU}✓{RESET} Hasil disimpan → {DEFOR_PATH}")
    print(f"  {HIJAU}✓{RESET} Sistem akan menggunakan nilai ini secara permanen.")
    return hasil


