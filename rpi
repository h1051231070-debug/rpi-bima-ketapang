#
# sensor.py — Pembacaan sensor dan mode dummy (PREDIKTA)
#
# MODE_DUMMY = True  → generate data sensor realistis (untuk testing)
# MODE_DUMMY = False → baca sensor fisik DS18B20, SHT31, PMS5003T, JSN-SR04T, MQ-7 (ADS1115)
